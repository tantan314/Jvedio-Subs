Dialogue: 0,0:00:01.24,0:00:07.21,Default,,0,0,0,,(感谢粉丝活动会场) 2015年某月
Dialogue: 0,0:00:07.51,0:00:11.58,Default,,0,0,0,,里美由理亚的感谢活动
Dialogue: 0,0:00:15.69,0:00:20.82,Default,,0,0,0,,谢谢各位粉丝的支持\N特别主办感谢活动
Dialogue: 0,0:00:24.46,0:00:28.86,Default,,0,0,0,,来的各位当然是...
Dialogue: 0,0:00:37.74,0:00:40.74,Default,,0,0,0,,早安\N早安
Dialogue: 0,0:00:41.01,0:00:45.31,Default,,0,0,0,,好多人唷
Dialogue: 0,0:00:45.92,0:00:48.15,Default,,0,0,0,,是的
Dialogue: 0,0:00:48.32,0:00:51.19,Default,,0,0,0,,感觉怎样?
Dialogue: 0,0:00:51.42,0:00:56.19,Default,,0,0,0,,不知道呢
Dialogue: 0,0:00:56.36,0:00:59.43,Default,,0,0,0,,很兴奋吧
Dialogue: 0,0:00:59.63,0:01:04.50,Default,,0,0,0,,很久没办了
Dialogue: 0,0:01:04.50,0:01:06.50,Default,,0,0,0,,对啊
Dialogue: 0,0:01:06.80,0:01:10.64,Default,,0,0,0,,感觉好兴奋
Dialogue: 0,0:01:10.87,0:01:14.34,Default,,0,0,0,,我现在...
Dialogue: 0,0:01:14.61,0:01:18.65,Default,,0,0,0,,很期待
Dialogue: 0,0:01:18.82,0:01:23.59,Default,,0,0,0,,要好好感谢大家
Dialogue: 0,0:01:23.89,0:01:28.02,Default,,0,0,0,,用你的身体
Dialogue: 0,0:01:28.22,0:01:32.63,Default,,0,0,0,,我懂的
Dialogue: 0,0:01:32.86,0:01:37.17,Default,,0,0,0,,会加油吧
Dialogue: 0,0:01:37.33,0:01:40.97,Default,,0,0,0,,请多指教
Dialogue: 0,0:01:41.27,0:01:46.78,Default,,0,0,0,,里美由理亚大乱交感谢活动
Dialogue: 0,0:01:58.89,0:02:02.72,Default,,0,0,0,,太赞了
Dialogue: 0,0:02:02.99,0:02:05.06,Default,,0,0,0,,爱你
Dialogue: 0,0:02:05.30,0:02:09.63,Default,,0,0,0,,大家好
Dialogue: 0,0:02:09.80,0:02:13.10,Default,,0,0,0,,我是里美
Dialogue: 0,0:02:14.87,0:02:19.68,Default,,0,0,0,,请多指教
Dialogue: 0,0:02:20.24,0:02:24.78,Default,,0,0,0,,我会跟大家
Dialogue: 0,0:02:25.18,0:02:30.02,Default,,0,0,0,,做各种事
Dialogue: 0,0:02:32.36,0:02:36.09,Default,,0,0,0,,可以吗?
Dialogue: 0,0:02:36.13,0:02:38.73,Default,,0,0,0,,没问题!
Dialogue: 0,0:02:39.36,0:02:43.73,Default,,0,0,0,,那开始吧
Dialogue: 0,0:02:43.93,0:02:47.90,Default,,0,0,0,,我想了解大家
Dialogue: 0,0:02:48.37,0:02:52.87,Default,,0,0,0,,先请自我介绍
Dialogue: 0,0:02:54.98,0:02:58.38,Default,,0,0,0,,哪位先?
Dialogue: 0,0:02:58.82,0:03:01.15,Default,,0,0,0,,来
Dialogue: 0,0:03:01.68,0:03:06.32,Default,,0,0,0,,我先\N你好
Dialogue: 0,0:03:06.72,0:03:11.36,Default,,0,0,0,,谢谢你的支持
Dialogue: 0,0:03:11.56,0:03:15.80,Default,,0,0,0,,请坐
Dialogue: 0,0:03:16.10,0:03:18.90,Default,,0,0,0,,你好
Dialogue: 0,0:03:19.44,0:03:24.51,Default,,0,0,0,,我是横滨来的\N(里美的粉丝自我介绍中)
Dialogue: 0,0:03:24.64,0:03:29.21,Default,,0,0,0,,这是?\N这个
Dialogue: 0,0:03:31.05,0:03:36.02,Default,,0,0,0,,希望你可以舔我
Dialogue: 0,0:03:37.85,0:03:40.76,Default,,0,0,0,,好的
Dialogue: 0,0:03:40.76,0:03:44.66,Default,,0,0,0,,我会加油
Dialogue: 0,0:03:44.99,0:03:48.90,Default,,0,0,0,,请多指教
Dialogue: 0,0:03:48.90,0:03:51.00,Default,,0,0,0,,你叫太郎
Dialogue: 0,0:03:51.00,0:03:54.67,Default,,0,0,0,,是的
Dialogue: 0,0:03:55.10,0:03:58.44,Default,,0,0,0,,这是我希望你做的\N(深吻跟打手枪)
Dialogue: 0,0:03:58.57,0:04:03.15,Default,,0,0,0,,好的,我知道了
Dialogue: 0,0:04:03.41,0:04:06.45,Default,,0,0,0,,等等来做吧
Dialogue: 0,0:04:10.85,0:04:14.46,Default,,0,0,0,,来好几次了呢
Dialogue: 0,0:04:14.69,0:04:16.93,Default,,0,0,0,,(想打情骂俏)
Dialogue: 0,0:04:16.93,0:04:18.93,Default,,0,0,0,,这样啊
Dialogue: 0,0:04:19.10,0:04:23.83,Default,,0,0,0,,想恩恩爱爱的啊
Dialogue: 0,0:04:23.83,0:04:25.80,Default,,0,0,0,,我懂了
Dialogue: 0,0:04:26.07,0:04:30.14,Default,,0,0,0,,我喜欢恩爱的
Dialogue: 0,0:04:30.14,0:04:32.14,Default,,0,0,0,,好的
Dialogue: 0,0:04:33.21,0:04:35.98,Default,,0,0,0,,麻烦你了
Dialogue: 0,0:04:35.98,0:04:42.92,Default,,0,0,0,,你几岁啦
Dialogue: 0,0:04:42.92,0:04:45.45,Default,,0,0,0,,(﻿想玩69还有口交)
Dialogue: 0,0:04:45.72,0:04:49.02,Default,,0,0,0,,我喜欢口交
Dialogue: 0,0:04:49.03,0:04:51.16,Default,,0,0,0,,还有屁股
Dialogue: 0,0:04:51.16,0:04:53.03,Default,,0,0,0,,所以69啊
Dialogue: 0,0:04:57.03,0:04:57.63,Default,,0,0,0,,这样啊
Dialogue: 0,0:04:57.63,0:05:01.04,Default,,0,0,0,,麻烦你了
Dialogue: 0,0:05:01.24,0:05:06.04,Default,,0,0,0,,很多人都喜欢69呢
Dialogue: 0,0:05:06.04,0:05:10.35,Default,,0,0,0,,请多指教
Dialogue: 0,0:05:10.35,0:05:13.72,Default,,0,0,0,,我是自由业
Dialogue: 0,0:05:13.72,0:05:18.72,Default,,0,0,0,,一直喜欢你
Dialogue: 0,0:05:18.72,0:05:20.72,Default,,0,0,0,,谢谢
Dialogue: 0,0:05:20.96,0:05:25.86,Default,,0,0,0,,(﻿想玩吸奶玩法然后被打手枪)
Dialogue: 0,0:05:26.06,0:05:30.33,Default,,0,0,0,,我喜欢吸奶\N这样啊
Dialogue: 0,0:05:30.33,0:05:32.10,Default,,0,0,0,,没有奶唷
Dialogue: 0,0:05:32.30,0:05:37.11,Default,,0,0,0,,没问题的
Dialogue: 0,0:05:37.11,0:05:41.28,Default,,0,0,0,,好的
Dialogue: 0,0:05:41.28,0:05:45.98,Default,,0,0,0,,请多指教
Dialogue: 0,0:05:45.98,0:05:50.42,Default,,0,0,0,,那个
Dialogue: 0,0:05:50.42,0:05:52.42,Default,,0,0,0,,我很喜欢你
Dialogue: 0,0:05:52.42,0:05:56.99,Default,,0,0,0,,谢谢
Dialogue: 0,0:05:56.99,0:06:01.26,Default,,0,0,0,,我想在电车上
Dialogue: 0,0:06:01.76,0:06:05.87,Default,,0,0,0,,电车不行啦
Dialogue: 0,0:06:05.87,0:06:10.54,Default,,0,0,0,,我知道的
Dialogue: 0,0:06:10.54,0:06:15.08,Default,,0,0,0,,这是我的希望
Dialogue: 0,0:06:15.08,0:06:20.02,Default,,0,0,0,,想被口交
Dialogue: 0,0:06:20.02,0:06:24.05,Default,,0,0,0,,口交﻿啊
Dialogue: 0,0:06:25.69,0:06:30.13,Default,,0,0,0,,要玩蛋蛋
Dialogue: 0,0:06:30.29,0:06:34.13,Default,,0,0,0,,我喜欢那种
Dialogue: 0,0:06:34.13,0:06:38.13,Default,,0,0,0,,好的
Dialogue: 0,0:06:38.13,0:06:42.40,Default,,0,0,0,,我又来了
Dialogue: 0,0:06:42.41,0:06:46.78,Default,,0,0,0,,谢谢
Dialogue: 0,0:06:46.91,0:06:51.75,Default,,0,0,0,,被舔蛋蛋然后打手枪
Dialogue: 0,0:06:51.75,0:06:55.82,Default,,0,0,0,,还想要摸奶
Dialogue: 0,0:06:55.82,0:07:00.36,Default,,0,0,0,,我知道了
Dialogue: 0,0:07:00.36,0:07:02.36,Default,,0,0,0,,大家都想打手枪呢
Dialogue: 0,0:07:04.79,0:07:07.70,Default,,0,0,0,,麻烦你了
Dialogue: 0,0:07:08.03,0:07:12.27,Default,,0,0,0,,你的是?
Dialogue: 0,0:07:13.50,0:07:18.51,Default,,0,0,0,,我非常喜欢胸部 让我摸舔
Dialogue: 0,0:07:18.51,0:07:21.31,Default,,0,0,0,,还有乳交
Dialogue: 0,0:07:21.31,0:07:26.28,Default,,0,0,0,,好可爱唷
Dialogue: 0,0:07:26.28,0:07:31.12,Default,,0,0,0,,麻烦你了
Dialogue: 0,0:07:31.12,0:07:35.12,Default,,0,0,0,,好的
Dialogue: 0,0:07:35.12,0:07:38.66,Default,,0,0,0,,等等来做吧
Dialogue: 0,0:07:38.66,0:07:42.76,Default,,0,0,0,,你好
Dialogue: 0,0:07:42.77,0:07:47.44,Default,,0,0,0,,请多指教 谢谢
Dialogue: 0,0:07:47.67,0:07:51.04,Default,,0,0,0,,啥?
Dialogue: 0,0:07:51.04,0:07:54.64,Default,,0,0,0,,想看我自慰
Dialogue: 0,0:07:55.51,0:08:00.08,Default,,0,0,0,,好可爱
Dialogue: 0,0:08:00.08,0:08:04.75,Default,,0,0,0,,没问题
Dialogue: 0,0:08:10.89,0:08:15.23,Default,,0,0,0,,想要公主抱
Dialogue: 0,0:08:15.50,0:08:20.20,Default,,0,0,0,,边接吻边打手枪
Dialogue: 0,0:08:20.20,0:08:24.01,Default,,0,0,0,,我很重耶
Dialogue: 0,0:08:24.01,0:08:25.84,Default,,0,0,0,,没问题的
Dialogue: 0,0:08:25.88,0:08:30.68,Default,,0,0,0,,真的吗?
Dialogue: 0,0:08:30.68,0:08:34.52,Default,,0,0,0,,拜托你了
Dialogue: 0,0:08:34.52,0:08:38.65,Default,,0,0,0,,加油
Dialogue: 0,0:08:38.79,0:08:43.43,Default,,0,0,0,,好像见过几次呢
Dialogue: 0,0:08:43.43,0:08:49.40,Default,,0,0,0,,谢谢
Dialogue: 0,0:08:49.40,0:08:52.83,Default,,0,0,0,,这个
Dialogue: 0,0:08:52.97,0:08:57.34,Default,,0,0,0,,(先骑我脸上\N然后恩爱的做爱)
Dialogue: 0,0:08:57.47,0:09:02.01,Default,,0,0,0,,请骑我的脸
Dialogue: 0,0:09:02.01,0:09:07.65,Default,,0,0,0,,我很少做耶
Dialogue: 0,0:09:08.02,0:09:10.55,Default,,0,0,0,,好的
Dialogue: 0,0:09:11.09,0:09:15.39,Default,,0,0,0,,麻烦你了
Dialogue: 0,0:09:19.56,0:09:23.50,Default,,0,0,0,,感觉很怕生呢
Dialogue: 0,0:09:23.83,0:09:29.10,Default,,0,0,0,,(﻿想被舔乳头口交)\N你这样就好了吗?
Dialogue: 0,0:09:29.27,0:09:33.34,Default,,0,0,0,,好的 我知道了
Dialogue: 0,0:09:34.68,0:09:39.28,Default,,0,0,0,,舔乳头还有口交
Dialogue: 0,0:09:41.42,0:09:44.92,Default,,0,0,0,,要舔乳头啊
Dialogue: 0,0:09:45.86,0:09:49.32,Default,,0,0,0,,我知道了
Dialogue: 0,0:09:52.13,0:09:56.90,Default,,0,0,0,,痴女风的玩弄我舔我乳头
Dialogue: 0,0:09:57.13,0:10:01.30,Default,,0,0,0,,我喜欢被玩弄
Dialogue: 0,0:10:01.30,0:10:03.24,Default,,0,0,0,,讨厌啦
Dialogue: 0,0:10:08.11,0:10:13.08,Default,,0,0,0,,我很少扮痴女耶
