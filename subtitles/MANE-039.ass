Dialogue: 0,0:15:17.48,0:15:19.41,Default,,0,0,0,,站起来
Dialogue: 0,0:15:19.48,0:15:21.42,Default,,0,0,0,,想要我蹂躏吧
Dialogue: 0,0:15:21.42,0:15:23.32,Default,,0,0,0,,喂
Dialogue: 0,0:15:24.19,0:15:26.19,Default,,0,0,0,,想要我踩躏吧
Dialogue: 0,0:15:26.19,0:15:27.86,Default,,0,0,0,,喂
Dialogue: 0,0:15:28.86,0:15:34.40,Default,,0,0,0,,这样有感觉吧
Dialogue: 0,0:15:39.10,0:15:40.83,Default,,0,0,0,,为什么有感觉
Dialogue: 0,0:15:43.94,0:15:46.87,Default,,0,0,0,,站起来 好厉害
Dialogue: 0,0:15:46.94,0:15:49.31,Default,,0,0,0,,蛋蛋伸展这么长啊
Dialogue: 0,0:15:49.31,0:15:51.18,Default,,0,0,0,,不行了
Dialogue: 0,0:15:58.05,0:15:59.69,Default,,0,0,0,,对不起啊
Dialogue: 0,0:15:59.72,0:16:02.49,Default,,0,0,0,,疼吗
Dialogue: 0,0:16:05.06,0:16:08.73,Default,,0,0,0,,我听说你喜欢被蹂躏蛋蛋
Dialogue: 0,0:16:09.23,0:16:11.20,Default,,0,0,0,,我就蹂躏了
Dialogue: 0,0:16:11.20,0:16:12.53,Default,,0,0,0,,谢谢
Dialogue: 0,0:16:12.57,0:16:14.94,Default,,0,0,0,,在看我吗
Dialogue: 0,0:16:16.60,0:16:18.44,Default,,0,0,0,,不可以哦
Dialogue: 0,0:16:23.08,0:16:25.85,Default,,0,0,0,,累了
Dialogue: 0,0:16:37.13,0:16:40.66,Default,,0,0,0,,不要看别处
Dialogue: 0,0:16:40.73,0:16:43.10,Default,,0,0,0,,为什么擅自看别的地方
Dialogue: 0,0:16:43.23,0:16:46.17,Default,,0,0,0,,睁开眼睛
Dialogue: 0,0:16:46.23,0:16:47.87,Default,,0,0,0,,好好看着我
Dialogue: 0,0:16:47.87,0:16:49.24,Default,,0,0,0,,来吧
Dialogue: 0,0:16:49.27,0:16:50.30,Default,,0,0,0,,眼睛
Dialogue: 0,0:16:50.44,0:16:52.07,Default,,0,0,0,,看着我哦
Dialogue: 0,0:16:55.14,0:16:57.41,Default,,0,0,0,,睁开眼睛
Dialogue: 0,0:16:57.48,0:17:01.52,Default,,0,0,0,,不要看着哦
Dialogue: 0,0:17:01.65,0:17:06.69,Default,,0,0,0,,看着我哦
Dialogue: 0,0:17:09.36,0:17:11.73,Default,,0,0,0,,不要闭上眼睛
Dialogue: 0,0:17:11.79,0:17:14.76,Default,,0,0,0,,就算疼也不要 加油啊
Dialogue: 0,0:17:14.76,0:17:17.56,Default,,0,0,0,,继续啊
Dialogue: 0,0:17:19.57,0:17:20.60,Default,,0,0,0,,喂
Dialogue: 0,0:17:20.70,0:17:22.40,Default,,0,0,0,,睁开眼睛啊
Dialogue: 0,0:17:22.44,0:17:25.77,Default,,0,0,0,,喂
Dialogue: 0,0:17:25.81,0:17:27.78,Default,,0,0,0,,想看我吧
Dialogue: 0,0:17:27.81,0:17:30.14,Default,,0,0,0,,是的
Dialogue: 0,0:17:30.25,0:17:31.95,Default,,0,0,0,,这次是奖励你哦
Dialogue: 0,0:17:32.08,0:17:33.08,Default,,0,0,0,,喂
Dialogue: 0,0:17:34.15,0:17:35.82,Default,,0,0,0,,喂
Dialogue: 0,0:17:35.85,0:17:37.85,Default,,0,0,0,,闭上眼睛了吧
Dialogue: 0,0:17:39.35,0:17:42.49,Default,,0,0,0,,好乖啊
Dialogue: 0,0:17:44.03,0:17:44.99,Default,,0,0,0,,看着我
Dialogue: 0,0:17:45.06,0:17:48.03,Default,,0,0,0,,继续啊
Dialogue: 0,0:17:48.06,0:17:50.16,Default,,0,0,0,,睁开眼睛啊
Dialogue: 0,0:17:52.03,0:17:53.67,Default,,0,0,0,,看着我啊
Dialogue: 0,0:17:55.94,0:17:57.47,Default,,0,0,0,,看着我的眼睛
Dialogue: 0,0:18:01.44,0:18:07.41,Default,,0,0,0,,刚才闭上眼睛了吧
Dialogue: 0,0:18:07.65,0:18:09.85,Default,,0,0,0,,喂
Dialogue: 0,0:18:09.85,0:18:12.32,Default,,0,0,0,,为什么擅自闭上眼睛了
Dialogue: 0,0:18:12.32,0:18:13.82,Default,,0,0,0,,喂
Dialogue: 0,0:18:14.89,0:18:16.02,Default,,0,0,0,,不要看别处
Dialogue: 0,0:18:16.02,0:18:18.39,Default,,0,0,0,,不要看别处啊
Dialogue: 0,0:18:18.49,0:18:19.73,Default,,0,0,0,,来吧
Dialogue: 0,0:18:20.06,0:18:23.33,Default,,0,0,0,,一直睁开眼睛
Dialogue: 0,0:18:25.77,0:18:27.33,Default,,0,0,0,,我给你口水
Dialogue: 0,0:18:28.60,0:18:30.04,Default,,0,0,0,,来吧
Dialogue: 0,0:18:33.64,0:18:38.28,Default,,0,0,0,,来吧
Dialogue: 0,0:18:39.48,0:18:41.32,Default,,0,0,0,,为什么擅自闭上眼睛了
Dialogue: 0,0:18:41.48,0:18:42.98,Default,,0,0,0,,喂
Dialogue: 0,0:18:45.02,0:18:46.22,Default,,0,0,0,,喂
Dialogue: 0,0:18:49.02,0:18:51.86,Default,,0,0,0,,为什么这样啊
Dialogue: 0,0:18:53.23,0:18:55.40,Default,,0,0,0,,为什么看下面了
Dialogue: 0,0:18:55.40,0:18:56.86,Default,,0,0,0,,喂
Dialogue: 0,0:19:06.61,0:19:09.48,Default,,0,0,0,,感谢我的回水吧
Dialogue: 0,0:19:15.08,0:19:19.02,Default,,0,0,0,,喂
Dialogue: 0,0:19:19.12,0:19:20.39,Default,,0,0,0,,为什么闭上眼睛了
Dialogue: 0,0:19:21.82,0:19:24.06,Default,,0,0,0,,谢谢
Dialogue: 0,0:19:26.66,0:19:30.36,Default,,0,0,0,,继续吧
Dialogue: 0,0:19:32.20,0:19:35.24,Default,,0,0,0,,谢谢
Dialogue: 0,0:19:35.27,0:19:36.90,Default,,0,0,0,,喂
Dialogue: 0,0:19:36.97,0:19:40.87,Default,,0,0,0,,想要撸管吧
Dialogue: 0,0:19:40.94,0:19:44.31,Default,,0,0,0,,是的\N继续硬起来\N
Dialogue: 0,0:19:44.31,0:19:45.48,Default,,0,0,0,,好的
Dialogue: 0,0:19:49.95,0:19:54.32,Default,,0,0,0,,为什么我蹂躏了
Dialogue: 0,0:19:54.39,0:19:58.73,Default,,0,0,0,,还是这样啊
Dialogue: 0,0:19:58.86,0:20:02.90,Default,,0,0,0,,想像了吧
Dialogue: 0,0:20:07.50,0:20:11.37,Default,,0,0,0,,真是变态
Dialogue: 0,0:20:14.74,0:20:15.91,Default,,0,0,0,,细心
Dialogue: 0,0:20:20.28,0:20:23.18,Default,,0,0,0,,干嘛啊
Dialogue: 0,0:20:23.25,0:20:25.22,Default,,0,0,0,,好恶心啊
Dialogue: 0,0:20:32.86,0:20:36.60,Default,,0,0,0,,喂
Dialogue: 0,0:20:36.70,0:20:39.20,Default,,0,0,0,,这样会坏掉吗
Dialogue: 0,0:20:40.17,0:20:44.24,Default,,0,0,0,,好舒服
Dialogue: 0,0:20:44.27,0:20:45.94,Default,,0,0,0,,为什么舒服了
Dialogue: 0,0:20:48.21,0:20:50.78,Default,,0,0,0,,不要摸我 好恶心
Dialogue: 0,0:20:54.48,0:20:56.02,Default,,0,0,0,,好厉害
Dialogue: 0,0:20:56.18,0:20:57.52,Default,,0,0,0,,来吧
Dialogue: 0,0:21:00.16,0:21:01.72,Default,,0,0,0,,这样会坏掉吗
Dialogue: 0,0:21:06.83,0:21:10.40,Default,,0,0,0,,肉棒要坏掉了
Dialogue: 0,0:21:10.90,0:21:11.73,Default,,0,0,0,,快点吧
Dialogue: 0,0:21:11.83,0:21:13.17,Default,,0,0,0,,蹲下吧
Dialogue: 0,0:21:16.24,0:21:18.44,Default,,0,0,0,,好厉害
Dialogue: 0,0:21:22.71,0:21:25.78,Default,,0,0,0,,好开心\N什么
Dialogue: 0,0:21:25.78,0:21:26.58,Default,,0,0,0,,开心啊
Dialogue: 0,0:21:29.85,0:21:30.75,Default,,0,0,0,,喂
Dialogue: 0,0:21:31.62,0:21:34.02,Default,,0,0,0,,好厉害
Dialogue: 0,0:21:39.93,0:21:41.90,Default,,0,0,0,,再硬起来
Dialogue: 0,0:21:42.06,0:21:44.83,Default,,0,0,0,,对不起
Dialogue: 0,0:21:44.90,0:21:46.33,Default,,0,0,0,,想要我蹂躏吧
Dialogue: 0,0:21:47.07,0:21:49.44,Default,,0,0,0,,是的\N再硬起来吧\N
Dialogue: 0,0:21:50.44,0:21:51.44,Default,,0,0,0,,好的
Dialogue: 0,0:21:54.28,0:21:56.78,Default,,0,0,0,,喂
Dialogue: 0,0:21:56.81,0:21:59.61,Default,,0,0,0,,你的肉棒
Dialogue: 0,0:21:59.65,0:22:01.68,Default,,0,0,0,,我给你口水\N谢谢
Dialogue: 0,0:22:04.45,0:22:05.89,Default,,0,0,0,,好开心
Dialogue: 0,0:22:07.32,0:22:12.83,Default,,0,0,0,,一直看着我
Dialogue: 0,0:22:13.50,0:22:15.86,Default,,0,0,0,,好开心
Dialogue: 0,0:22:15.90,0:22:19.60,Default,,0,0,0,,好舒服\N好厉害啊\N
Dialogue: 0,0:22:21.00,0:22:22.64,Default,,0,0,0,,真的是变态呢
Dialogue: 0,0:22:22.87,0:22:24.41,Default,,0,0,0,,是的
Dialogue: 0,0:22:24.44,0:22:26.81,Default,,0,0,0,,我想摸\N不行
Dialogue: 0,0:22:26.98,0:22:28.24,Default,,0,0,0,,不行
Dialogue: 0,0:22:28.31,0:22:31.95,Default,,0,0,0,,忍着
Dialogue: 0,0:22:32.08,0:22:33.61,Default,,0,0,0,,忍着不可以射
Dialogue: 0,0:22:33.62,0:22:36.62,Default,,0,0,0,,不要射
Dialogue: 0,0:22:36.69,0:22:38.19,Default,,0,0,0,,忍着哦
Dialogue: 0,0:22:38.22,0:22:40.19,Default,,0,0,0,,我知道了
Dialogue: 0,0:22:40.22,0:22:41.86,Default,,0,0,0,,看着我
Dialogue: 0,0:22:41.86,0:22:44.79,Default,,0,0,0,,喂
Dialogue: 0,0:22:47.06,0:22:49.23,Default,,0,0,0,,好舒服\N什么 不行\N
Dialogue: 0,0:22:49.33,0:22:50.83,Default,,0,0,0,,不可以射哦
Dialogue: 0,0:22:50.83,0:22:52.53,Default,,0,0,0,,要射了
Dialogue: 0,0:22:52.60,0:22:54.54,Default,,0,0,0,,不行 忍着
Dialogue: 0,0:22:54.60,0:22:56.30,Default,,0,0,0,,忍着哦
Dialogue: 0,0:22:56.44,0:22:57.81,Default,,0,0,0,,喂
Dialogue: 0,0:22:57.91,0:22:59.44,Default,,0,0,0,,喂
Dialogue: 0,0:23:00.41,0:23:02.98,Default,,0,0,0,,喂
Dialogue: 0,0:23:04.25,0:23:05.78,Default,,0,0,0,,喂
Dialogue: 0,0:23:07.15,0:23:10.15,Default,,0,0,0,,射了啊
Dialogue: 0,0:23:10.19,0:23:12.89,Default,,0,0,0,,干嘛擅自射了啊
Dialogue: 0,0:23:13.02,0:23:14.69,Default,,0,0,0,,对不起
Dialogue: 0,0:23:14.69,0:23:16.52,Default,,0,0,0,,喂
Dialogue: 0,0:23:16.52,0:23:18.99,Default,,0,0,0,,都是蛋蛋的错吧
Dialogue: 0,0:23:18.99,0:23:22.50,Default,,0,0,0,,喂
Dialogue: 0,0:23:25.77,0:23:27.50,Default,,0,0,0,,喂
Dialogue: 0,0:23:27.57,0:23:30.40,Default,,0,0,0,,弄到我的身上了
Dialogue: 0,0:23:32.44,0:23:33.97,Default,,0,0,0,,为什么擅自射了
Dialogue: 0,0:23:34.24,0:23:35.98,Default,,0,0,0,,我没有让你射啊
Dialogue: 0,0:23:35.98,0:23:37.48,Default,,0,0,0,,来吧
Dialogue: 0,0:23:37.51,0:23:41.32,Default,,0,0,0,,翘起屁股吧
Dialogue: 0,0:23:41.32,0:23:43.15,Default,,0,0,0,,张开腿吧
Dialogue: 0,0:23:43.15,0:23:46.29,Default,,0,0,0,,喂 就是这样哦
Dialogue: 0,0:23:46.29,0:23:47.99,Default,,0,0,0,,来吧
