Dialogue: 0,0:00:01.78,0:00:09.68,Default,,0,0,0,,(在日本的某處...)
Dialogue: 0,0:00:10.62,0:00:18.62,Default,,0,0,0,,(只有被選中的人) (才能到達的極讚空間)
Dialogue: 0,0:00:23.44,0:00:28.93,Default,,0,0,0,,(用日本最頂尖泡浴來滿足吧)
Dialogue: 0,0:00:32.95,0:00:33.95,Default,,0,0,0,,歡迎光臨
Dialogue: 0,0:00:35.84,0:00:38.36,Default,,0,0,0,,客人您又來了呢
Dialogue: 0,0:00:39.22,0:00:42.28,Default,,0,0,0,,非常感謝您多次光臨本店
Dialogue: 0,0:00:44.29,0:00:46.89,Default,,0,0,0,,今天當然也是包下來的
Dialogue: 0,0:00:47.49,0:00:48.67,Default,,0,0,0,,這邊請
Dialogue: 0,0:00:54.05,0:00:55.31,Default,,0,0,0,,這邊請
Dialogue: 0,0:01:24.06,0:01:25.40,Default,,0,0,0,,失禮了
Dialogue: 0,0:01:31.12,0:01:32.23,Default,,0,0,0,,久等了
Dialogue: 0,0:01:36.82,0:01:42.87,Default,,0,0,0,,請問能花些時間， 為您說明本店的內容嗎？
Dialogue: 0,0:01:44.95,0:01:49.68,Default,,0,0,0,,本店只有190分的內容
Dialogue: 0,0:01:51.65,0:01:58.90,Default,,0,0,0,,為了能讓客人滿足， 工作人員禁止使用衛生器具
Dialogue: 0,0:02:00.64,0:02:01.83,Default,,0,0,0,,這一點您知道的吧？
Dialogue: 0,0:02:04.85,0:02:10.70,Default,,0,0,0,,準備好後馬上會過來， 還請您稍待片刻
Dialogue: 0,0:02:11.41,0:02:12.64,Default,,0,0,0,,失禮了
Dialogue: 0,0:02:30.31,0:02:35.21,Default,,0,0,0,,客人久等了， 這就為您帶路，這邊請
Dialogue: 0,0:02:49.16,0:02:54.30,Default,,0,0,0,,歡迎光臨， 我是今天負責的波多野
Dialogue: 0,0:02:55.20,0:02:56.60,Default,,0,0,0,,請你多多指教
Dialogue: 0,0:03:01.42,0:03:09.03,Default,,0,0,0,,(超高級中出泡浴)
Dialogue: 0,0:03:13.80,0:03:14.80,Default,,0,0,0,,客人
Dialogue: 0,0:03:17.47,0:03:19.29,Default,,0,0,0,,脫外套囉，失禮了
Dialogue: 0,0:03:28.14,0:03:29.81,Default,,0,0,0,,就掛在這邊哦
Dialogue: 0,0:03:46.99,0:03:51.60,Default,,0,0,0,,再次介紹，我是波多野
Dialogue: 0,0:03:53.11,0:03:58.33,Default,,0,0,0,,非常感謝今天的光臨， 請您多多指教
Dialogue: 0,0:04:07.32,0:04:09.77,Default,,0,0,0,,好像很緊張呢
Dialogue: 0,0:04:16.70,0:04:20.64,Default,,0,0,0,,客人很帥呢
Dialogue: 0,0:04:23.37,0:04:25.23,Default,,0,0,0,,你也很美啊
Dialogue: 0,0:04:26.13,0:04:27.23,Default,,0,0,0,,真的嗎？
Dialogue: 0,0:04:30.03,0:04:32.38,Default,,0,0,0,,第一次遇到這麼帥的客人
Dialogue: 0,0:04:35.14,0:04:36.90,Default,,0,0,0,,笑容也很棒呢
Dialogue: 0,0:04:39.79,0:04:40.97,Default,,0,0,0,,迷上了呢
Dialogue: 0,0:04:50.86,0:04:54.48,Default,,0,0,0,,請不要移開眼神 - 會不好意思
Dialogue: 0,0:04:58.02,0:04:59.47,Default,,0,0,0,,客人真可愛
Dialogue: 0,0:05:09.19,0:05:10.53,Default,,0,0,0,,身材真好
Dialogue: 0,0:05:11.64,0:05:14.41,Default,,0,0,0,,真的嗎？好開心
Dialogue: 0,0:05:16.67,0:05:18.58,Default,,0,0,0,,能再靠近點看嗎？
Dialogue: 0,0:05:20.40,0:05:21.57,Default,,0,0,0,,好緊張
Dialogue: 0,0:05:23.73,0:05:25.97,Default,,0,0,0,,緊張的樣子也很可愛
Dialogue: 0,0:05:31.00,0:05:32.00,Default,,0,0,0,,客人
Dialogue: 0,0:07:07.13,0:07:08.13,Default,,0,0,0,,好爽
Dialogue: 0,0:07:10.61,0:07:12.81,Default,,0,0,0,,這樣子很爽嗎？
Dialogue: 0,0:07:29.99,0:07:31.88,Default,,0,0,0,,身體抖不停呢
Dialogue: 0,0:07:48.36,0:07:52.22,Default,,0,0,0,,我可以舔嗎？　　-快點舔吧
Dialogue: 0,0:08:44.58,0:08:45.75,Default,,0,0,0,,好爽
Dialogue: 0,0:09:27.99,0:09:31.64,Default,,0,0,0,,我可以脫去禮服嗎？
Dialogue: 0,0:09:39.56,0:09:42.05,Default,,0,0,0,,可以幫我嗎？　　-可以啊
Dialogue: 0,0:09:45.03,0:09:46.33,Default,,0,0,0,,拜託了
Dialogue: 0,0:09:55.29,0:09:56.51,Default,,0,0,0,,謝謝
Dialogue: 0,0:10:05.77,0:10:07.24,Default,,0,0,0,,覺得好害羞呢
Dialogue: 0,0:10:16.64,0:10:18.64,Default,,0,0,0,,真美的身體
Dialogue: 0,0:10:20.46,0:10:23.31,Default,,0,0,0,,您這麼說真開心
Dialogue: 0,0:11:04.04,0:11:06.57,Default,,0,0,0,,變得好硬了呢
Dialogue: 0,0:11:32.66,0:11:34.73,Default,,0,0,0,,爽嗎？　　-實在好讚
Dialogue: 0,0:11:38.04,0:11:39.70,Default,,0,0,0,,失禮了
Dialogue: 0,0:12:04.44,0:12:05.49,Default,,0,0,0,,好讚
Dialogue: 0,0:12:11.11,0:12:14.33,Default,,0,0,0,,客人的這裡好熱啊
Dialogue: 0,0:12:58.52,0:12:59.52,Default,,0,0,0,,好讚
Dialogue: 0,0:13:06.21,0:13:07.47,Default,,0,0,0,,爽嗎？
Dialogue: 0,0:13:10.44,0:13:12.02,Default,,0,0,0,,讓人真焦躁呢
Dialogue: 0,0:13:14.20,0:13:18.16,Default,,0,0,0,,討厭焦躁嗎？　　-倒也不是
Dialogue: 0,0:13:36.05,0:13:37.24,Default,,0,0,0,,失禮了
Dialogue: 0,0:14:33.92,0:14:35.24,Default,,0,0,0,,好爽
Dialogue: 0,0:14:37.54,0:14:38.76,Default,,0,0,0,,覺得爽嗎？
Dialogue: 0,0:14:52.71,0:14:54.26,Default,,0,0,0,,真行呢
Dialogue: 0,0:14:58.16,0:15:00.53,Default,,0,0,0,,請盡情地爽哦
Dialogue: 0,0:15:12.28,0:15:13.52,Default,,0,0,0,,好讚
Dialogue: 0,0:15:26.68,0:15:28.31,Default,,0,0,0,,這裡也失禮了
Dialogue: 0,0:16:10.89,0:16:12.27,Default,,0,0,0,,實在很好吃
Dialogue: 0,0:16:37.66,0:16:38.98,Default,,0,0,0,,含得真深
Dialogue: 0,0:16:51.20,0:16:52.31,Default,,0,0,0,,客人...
Dialogue: 0,0:17:22.42,0:17:28.20,Default,,0,0,0,,客人，可以插入嗎？
Dialogue: 0,0:17:51.98,0:17:53.36,Default,,0,0,0,,客人
Dialogue: 0,0:17:56.53,0:17:57.87,Default,,0,0,0,,進來囉
Dialogue: 0,0:18:02.08,0:18:03.38,Default,,0,0,0,,好大
Dialogue: 0,0:18:14.38,0:18:16.77,Default,,0,0,0,,實在好爽
Dialogue: 0,0:18:27.73,0:18:31.64,Default,,0,0,0,,客人，好爽　　-實在好爽呢
Dialogue: 0,0:19:36.09,0:19:37.73,Default,,0,0,0,,客人
Dialogue: 0,0:19:39.76,0:19:41.06,Default,,0,0,0,,也換這樣子吧
Dialogue: 0,0:19:47.45,0:19:48.73,Default,,0,0,0,,真淫蕩呢
Dialogue: 0,0:19:51.12,0:19:54.41,Default,,0,0,0,,客人，還想要更多呢
Dialogue: 0,0:20:01.26,0:20:02.81,Default,,0,0,0,,進來了
Dialogue: 0,0:20:28.68,0:20:30.21,Default,,0,0,0,,好讚
Dialogue: 0,0:20:36.02,0:20:39.39,Default,,0,0,0,,客人插得好讚
Dialogue: 0,0:20:56.80,0:20:58.35,Default,,0,0,0,,從後面來插吧
Dialogue: 0,0:21:57.29,0:22:00.41,Default,,0,0,0,,這樣子好爽
Dialogue: 0,0:22:05.88,0:22:08.15,Default,,0,0,0,,夾得真緊呢
Dialogue: 0,0:22:54.93,0:22:57.28,Default,,0,0,0,,要去了
Dialogue: 0,0:23:40.78,0:23:46.48,Default,,0,0,0,,好爽 - 客人，讓我看您的臉
Dialogue: 0,0:24:40.26,0:24:41.96,Default,,0,0,0,,實在好爽
Dialogue: 0,0:25:33.54,0:25:34.82,Default,,0,0,0,,真美呢
Dialogue: 0,0:25:36.27,0:25:40.18,Default,,0,0,0,,好開心呢，客人
Dialogue: 0,0:25:43.60,0:25:44.96,Default,,0,0,0,,好讚
Dialogue: 0,0:26:21.96,0:26:27.14,Default,,0,0,0,,客人，好爽，好讚
Dialogue: 0,0:26:28.65,0:26:29.76,Default,,0,0,0,,好爽
Dialogue: 0,0:26:37.30,0:26:42.35,Default,,0,0,0,,客人的實在好硬 - 快要射了
Dialogue: 0,0:26:43.94,0:26:47.99,Default,,0,0,0,,可以哦，爽爽全部射出吧
Dialogue: 0,0:26:57.12,0:26:58.55,Default,,0,0,0,,要射了
Dialogue: 0,0:27:32.66,0:27:37.01,Default,,0,0,0,,射好多呢　　-因為好爽
Dialogue: 0,0:28:18.50,0:28:19.86,Default,,0,0,0,,客人
Dialogue: 0,0:28:26.48,0:28:28.35,Default,,0,0,0,,一下就射了呢
Dialogue: 0,0:28:29.33,0:28:31.09,Default,,0,0,0,,實在好爽
Dialogue: 0,0:28:31.43,0:28:33.09,Default,,0,0,0,,我也好爽
Dialogue: 0,0:28:34.63,0:28:37.29,Default,,0,0,0,,累了嗎？　　-沒關係
Dialogue: 0,0:28:39.12,0:28:43.35,Default,,0,0,0,,要如何？直接休息？
Dialogue: 0,0:28:46.56,0:28:50.10,Default,,0,0,0,,洗澡好了　　-要洗澡嗎？
Dialogue: 0,0:28:50.79,0:28:57.74,Default,,0,0,0,,那我去準備， 請在床上躺著休息吧
Dialogue: 0,0:28:58.35,0:28:59.74,Default,,0,0,0,,謝謝
Dialogue: 0,0:29:07.91,0:29:09.48,Default,,0,0,0,,請躺下來吧
Dialogue: 0,0:29:19.14,0:29:21.84,Default,,0,0,0,,謝謝　　-請稍等哦
Dialogue: 0,0:29:24.69,0:29:30.81,Default,,0,0,0,,有好好睡一會了呢， 那麼來洗身體囉
Dialogue: 0,0:29:57.02,0:29:58.65,Default,,0,0,0,,失禮了
Dialogue: 0,0:30:00.24,0:30:04.06,Default,,0,0,0,,覺得熱水如何？
Dialogue: 0,0:30:25.28,0:30:27.50,Default,,0,0,0,,爽嗎？　　-好爽
Dialogue: 0,0:30:35.91,0:30:37.25,Default,,0,0,0,,失禮了
Dialogue: 0,0:31:08.36,0:31:11.50,Default,,0,0,0,,接著洗身體囉
Dialogue: 0,0:31:29.29,0:31:30.59,Default,,0,0,0,,失禮了
Dialogue: 0,0:31:53.58,0:31:55.88,Default,,0,0,0,,客人覺得如何？　　-好爽
Dialogue: 0,0:32:12.50,0:32:14.40,Default,,0,0,0,,洗手囉，失禮了
Dialogue: 0,0:33:02.76,0:33:04.96,Default,,0,0,0,,也來洗身體囉
Dialogue: 0,0:34:01.05,0:34:02.37,Default,,0,0,0,,洗腳哦，失禮了
Dialogue: 0,0:34:38.37,0:34:39.48,Default,,0,0,0,,非常感謝
Dialogue: 0,0:34:47.40,0:34:49.68,Default,,0,0,0,,會覺得冷嗎？　　-不會
Dialogue: 0,0:35:19.35,0:35:22.20,Default,,0,0,0,,會覺得不舒服嗎？　　-不會
Dialogue: 0,0:35:28.13,0:35:31.19,Default,,0,0,0,,也來洗背後囉　　-麻煩你了
Dialogue: 0,0:36:23.48,0:36:25.08,Default,,0,0,0,,失禮了
Dialogue: 0,0:36:31.93,0:36:34.69,Default,,0,0,0,,不舒服嗎？　　-不，很爽
Dialogue: 0,0:36:35.97,0:36:40.46,Default,,0,0,0,,那太好了，那我就仔細洗囉
Dialogue: 0,0:37:02.52,0:37:04.74,Default,,0,0,0,,這樣子可以嗎？　　-可以
Dialogue: 0,0:37:11.36,0:37:14.02,Default,,0,0,0,,這裡也來洗哦
Dialogue: 0,0:37:25.96,0:37:27.93,Default,,0,0,0,,會覺得痛嗎？　　-不會
Dialogue: 0,0:38:03.13,0:38:06.82,Default,,0,0,0,,客人，會不舒服嗎？ - 不會
Dialogue: 0,0:38:08.69,0:38:10.78,Default,,0,0,0,,那麼來洗身體囉
Dialogue: 0,0:38:35.02,0:38:36.11,Default,,0,0,0,,失禮了
Dialogue: 0,0:38:45.29,0:38:47.16,Default,,0,0,0,,沒有不舒服吧？
Dialogue: 0,0:39:03.71,0:39:05.95,Default,,0,0,0,,來上精油囉
Dialogue: 0,0:39:29.33,0:39:31.24,Default,,0,0,0,,不會太燙嗎？
Dialogue: 0,0:39:49.97,0:39:52.00,Default,,0,0,0,,來洗手指囉
Dialogue: 0,0:40:43.04,0:40:45.10,Default,,0,0,0,,來換手哦
Dialogue: 0,0:41:26.90,0:41:29.56,Default,,0,0,0,,有溫暖嗎？　　-很溫暖
Dialogue: 0,0:41:46.44,0:41:49.50,Default,,0,0,0,,來塗背了哦
Dialogue: 0,0:42:13.68,0:42:17.56,Default,,0,0,0,,也來給下面弄乾淨哦
Dialogue: 0,0:42:26.88,0:42:28.50,Default,,0,0,0,,失禮了
Dialogue: 0,0:42:46.91,0:42:49.39,Default,,0,0,0,,客人，爽嗎？　　-好爽
Dialogue: 0,0:43:43.28,0:43:45.79,Default,,0,0,0,,爽嗎？　　-好爽
Dialogue: 0,0:43:46.21,0:43:48.03,Default,,0,0,0,,實在好硬呢
Dialogue: 0,0:44:24.78,0:44:27.15,Default,,0,0,0,,又好有活力了呢
Dialogue: 0,0:44:29.22,0:44:32.41,Default,,0,0,0,,要怎麼辦？再射出來？
Dialogue: 0,0:44:34.90,0:44:36.14,Default,,0,0,0,,我知道了
Dialogue: 0,0:44:38.09,0:44:39.62,Default,,0,0,0,,那就來好好爽吧
Dialogue: 0,0:44:59.69,0:45:02.29,Default,,0,0,0,,客人實在好脹呢
Dialogue: 0,0:45:28.08,0:45:30.99,Default,,0,0,0,,快要射了　　-可以哦
Dialogue: 0,0:45:33.13,0:45:36.52,Default,,0,0,0,,好讚，射好多呢
Dialogue: 0,0:45:45.70,0:45:47.71,Default,,0,0,0,,射出來了呢
Dialogue: 0,0:45:53.54,0:45:59.05,Default,,0,0,0,,好讚，有爽嗎？　　-好爽
Dialogue: 0,0:46:05.10,0:46:07.07,Default,,0,0,0,,我們來泡澡吧
Dialogue: 0,0:46:20.92,0:46:22.18,Default,,0,0,0,,失禮了
Dialogue: 0,0:46:29.03,0:46:34.18,Default,,0,0,0,,水溫覺得如何？可以嗎？
Dialogue: 0,0:46:35.96,0:46:38.00,Default,,0,0,0,,我能一起進去嗎？
Dialogue: 0,0:46:41.01,0:46:42.01,Default,,0,0,0,,失禮了
Dialogue: 0,0:46:56.77,0:47:00.42,Default,,0,0,0,,客人的肌肉好讚
Dialogue: 0,0:47:03.56,0:47:05.36,Default,,0,0,0,,有在鍛練？
Dialogue: 0,0:47:08.17,0:47:09.68,Default,,0,0,0,,每天上健身房啊？
Dialogue: 0,0:47:11.08,0:47:14.98,Default,,0,0,0,,好棒，腳也好硬呢
Dialogue: 0,0:47:18.64,0:47:20.11,Default,,0,0,0,,可以摸嗎？
Dialogue: 0,0:47:25.89,0:47:32.54,Default,,0,0,0,,好讚，胸口好厚，能動嗎？
Dialogue: 0,0:47:33.73,0:47:35.11,Default,,0,0,0,,動動看
Dialogue: 0,0:47:38.82,0:47:44.14,Default,,0,0,0,,好讚，會抖動呢
Dialogue: 0,0:47:47.12,0:47:53.22,Default,,0,0,0,,胸口厚覺得好讚呢
Dialogue: 0,0:47:55.69,0:47:59.77,Default,,0,0,0,,好想要躺這裡呢
Dialogue: 0,0:48:01.01,0:48:05.28,Default,,0,0,0,,沒什麼，就想試試呢
Dialogue: 0,0:48:17.27,0:48:22.57,Default,,0,0,0,,好讚，好厚，很舒服呢
Dialogue: 0,0:48:25.57,0:48:29.97,Default,,0,0,0,,感覺這樣子好放鬆
Dialogue: 0,0:48:34.03,0:48:35.54,Default,,0,0,0,,真想一直這樣
Dialogue: 0,0:48:38.87,0:48:40.61,Default,,0,0,0,,是真的這麼想的
Dialogue: 0,0:48:46.18,0:48:48.01,Default,,0,0,0,,這麼躺會睡著呢
Dialogue: 0,0:48:53.14,0:48:54.48,Default,,0,0,0,,好舒服
Dialogue: 0,0:49:10.80,0:49:12.16,Default,,0,0,0,,變硬了呢
Dialogue: 0,0:49:18.18,0:49:19.39,Default,,0,0,0,,爽嗎？
Dialogue: 0,0:49:25.57,0:49:28.72,Default,,0,0,0,,好讚，這裡也好硬
Dialogue: 0,0:49:39.74,0:49:41.23,Default,,0,0,0,,讓我看看
Dialogue: 0,0:49:53.86,0:49:56.58,Default,,0,0,0,,客人的好脹呢
Dialogue: 0,0:49:59.64,0:50:01.11,Default,,0,0,0,,想舔了呢
Dialogue: 0,0:50:26.46,0:50:32.68,Default,,0,0,0,,爽嗎？讓我多舔一點
Dialogue: 0,0:51:27.64,0:51:29.68,Default,,0,0,0,,實在好大
Dialogue: 0,0:51:31.27,0:51:32.88,Default,,0,0,0,,真好吃呢
Dialogue: 0,0:52:04.54,0:52:08.42,Default,,0,0,0,,深含有爽嗎？
Dialogue: 0,0:52:50.70,0:52:56.96,Default,,0,0,0,,客人，屁股能對著我嗎？
Dialogue: 0,0:53:14.54,0:53:15.86,Default,,0,0,0,,覺得害羞嗎？
Dialogue: 0,0:53:24.54,0:53:26.42,Default,,0,0,0,,客人的屁股真美
Dialogue: 0,0:53:50.89,0:53:54.37,Default,,0,0,0,,客人，可以舔這裡嗎？
Dialogue: 0,0:54:20.67,0:54:23.29,Default,,0,0,0,,客人的屁眼爽嗎？
Dialogue: 0,0:54:25.93,0:54:27.25,Default,,0,0,0,,實在抖好大呢
Dialogue: 0,0:55:36.33,0:55:39.03,Default,,0,0,0,,真有活力，馬上彈回去呢
Dialogue: 0,0:56:13.89,0:56:18.78,Default,,0,0,0,,客人爽嗎？看著這裡
Dialogue: 0,0:56:24.87,0:56:26.99,Default,,0,0,0,,再來更爽吧
Dialogue: 0,0:56:45.80,0:56:47.19,Default,,0,0,0,,爽嗎？
Dialogue: 0,0:56:56.22,0:57:01.27,Default,,0,0,0,,客人，喜歡奶子嗎？
Dialogue: 0,0:57:14.84,0:57:18.16,Default,,0,0,0,,客人的老二好爽
Dialogue: 0,0:57:20.31,0:57:24.17,Default,,0,0,0,,這麼摩著奶頭好爽
Dialogue: 0,0:57:50.44,0:57:53.50,Default,,0,0,0,,我的奶如何？
Dialogue: 0,0:57:56.12,0:57:58.59,Default,,0,0,0,,請盡情爽吧
Dialogue: 0,0:58:33.84,0:58:37.82,Default,,0,0,0,,看起來很爽呢，客人
Dialogue: 0,0:58:41.42,0:58:42.87,Default,,0,0,0,,真的很愛奶子呢
Dialogue: 0,0:59:18.34,0:59:19.74,Default,,0,0,0,,客人如何？
Dialogue: 0,0:59:45.60,0:59:48.64,Default,,0,0,0,,隨時可以射哦
Dialogue: 0,1:00:01.94,1:00:05.19,Default,,0,0,0,,好讚，射出來了
Dialogue: 0,1:00:22.45,1:00:25.76,Default,,0,0,0,,好讚，好濕黏呢
Dialogue: 0,1:00:32.38,1:00:33.45,Default,,0,0,0,,來清乾淨哦
Dialogue: 0,1:00:47.72,1:00:53.52,Default,,0,0,0,,客人如何？有爽嗎？
Dialogue: 0,1:02:37.72,1:02:44.55,Default,,0,0,0,,準備好了， 會有點滑，請小心點
Dialogue: 0,1:02:49.39,1:02:50.46,Default,,0,0,0,,上潤滑液囉
Dialogue: 0,1:02:54.82,1:02:55.82,Default,,0,0,0,,會不會太熱？
Dialogue: 0,1:03:19.06,1:03:20.30,Default,,0,0,0,,失禮了
Dialogue: 0,1:03:37.14,1:03:38.78,Default,,0,0,0,,客人爽嗎？
Dialogue: 0,1:04:47.29,1:04:49.09,Default,,0,0,0,,請好好爽哦
Dialogue: 0,1:05:09.56,1:05:10.82,Default,,0,0,0,,失禮了
Dialogue: 0,1:05:19.64,1:05:21.04,Default,,0,0,0,,屁股爽嗎？
Dialogue: 0,1:05:24.08,1:05:25.08,Default,,0,0,0,,太好了
Dialogue: 0,1:05:43.11,1:05:47.32,Default,,0,0,0,,客人，失禮了
Dialogue: 0,1:06:19.65,1:06:23.65,Default,,0,0,0,,客人，就這麼翹著
Dialogue: 0,1:06:51.20,1:06:52.63,Default,,0,0,0,,這裡爽嗎？
Dialogue: 0,1:07:23.70,1:07:25.48,Default,,0,0,0,,腰下去一點
Dialogue: 0,1:07:37.07,1:07:38.30,Default,,0,0,0,,失禮了
Dialogue: 0,1:08:20.27,1:08:21.47,Default,,0,0,0,,失禮了
Dialogue: 0,1:09:30.04,1:09:31.55,Default,,0,0,0,,爽嗎？
Dialogue: 0,1:10:05.45,1:10:07.48,Default,,0,0,0,,這裡爽嗎？
Dialogue: 0,1:10:40.65,1:10:42.39,Default,,0,0,0,,這樣子可以嗎？
Dialogue: 0,1:10:46.00,1:10:48.28,Default,,0,0,0,,實在變好硬了呢
Dialogue: 0,1:10:58.17,1:11:05.48,Default,,0,0,0,,客人，要轉正面了， 請把手給我
Dialogue: 0,1:11:21.30,1:11:22.35,Default,,0,0,0,,這樣子可以嗎？
Dialogue: 0,1:11:28.72,1:11:30.06,Default,,0,0,0,,失禮了
Dialogue: 0,1:12:16.22,1:12:17.56,Default,,0,0,0,,客人...
Dialogue: 0,1:12:31.99,1:12:34.59,Default,,0,0,0,,這樣子如何？
Dialogue: 0,1:12:50.56,1:12:53.13,Default,,0,0,0,,變得更硬了呢
Dialogue: 0,1:14:57.57,1:14:59.08,Default,,0,0,0,,這麼碰到好讚
Dialogue: 0,1:16:45.16,1:16:51.30,Default,,0,0,0,,客人也能舔我的嗎？
Dialogue: 0,1:17:18.31,1:17:19.50,Default,,0,0,0,,好爽
Dialogue: 0,1:17:56.32,1:17:58.87,Default,,0,0,0,,客人覺得如何？
Dialogue: 0,1:18:24.33,1:18:27.64,Default,,0,0,0,,實在好爽
Dialogue: 0,1:18:29.27,1:18:34.13,Default,,0,0,0,,我也來讓客人盡情爽哦
Dialogue: 0,1:20:11.58,1:20:13.47,Default,,0,0,0,,快要射了？
Dialogue: 0,1:20:21.14,1:20:27.42,Default,,0,0,0,,實在好脹呢， 這麼下去會很難受吧？
Dialogue: 0,1:20:37.12,1:20:42.76,Default,,0,0,0,,客人，實在受不了了
Dialogue: 0,1:20:52.63,1:20:55.21,Default,,0,0,0,,客人的好熱呢
Dialogue: 0,1:20:57.57,1:20:58.89,Default,,0,0,0,,這麼摩著好爽
Dialogue: 0,1:21:16.39,1:21:18.57,Default,,0,0,0,,客人爽嗎？
Dialogue: 0,1:21:53.60,1:21:59.34,Default,,0,0,0,,客人實在好硬
Dialogue: 0,1:22:10.43,1:22:12.02,Default,,0,0,0,,可以接吻嗎？
Dialogue: 0,1:23:11.38,1:23:14.85,Default,,0,0,0,,客人快要射了嘛？
Dialogue: 0,1:23:22.90,1:23:24.24,Default,,0,0,0,,可以插入嗎？
Dialogue: 0,1:23:46.81,1:23:48.71,Default,,0,0,0,,好爽
Dialogue: 0,1:24:13.02,1:24:15.97,Default,,0,0,0,,我的小穴爽嗎？
Dialogue: 0,1:25:06.47,1:25:08.90,Default,,0,0,0,,客人請要好好地爽哦
Dialogue: 0,1:25:36.05,1:25:37.88,Default,,0,0,0,,好爽
Dialogue: 0,1:26:08.11,1:26:11.92,Default,,0,0,0,,客人，這裡也要
Dialogue: 0,1:26:54.83,1:26:56.38,Default,,0,0,0,,實在好硬
Dialogue: 0,1:27:46.94,1:27:48.18,Default,,0,0,0,,爽嗎？
Dialogue: 0,1:28:01.42,1:28:07.24,Default,,0,0,0,,客人能從後面插嗎？
Dialogue: 0,1:28:16.21,1:28:17.70,Default,,0,0,0,,好爽
Dialogue: 0,1:28:35.70,1:28:37.77,Default,,0,0,0,,好爽
Dialogue: 0,1:28:42.15,1:28:45.04,Default,,0,0,0,,請盡情插吧
Dialogue: 0,1:29:02.45,1:29:09.33,Default,,0,0,0,,要去了
Dialogue: 0,1:29:22.69,1:29:27.43,Default,,0,0,0,,客人請再多插點
Dialogue: 0,1:29:43.92,1:29:45.22,Default,,0,0,0,,好爽
Dialogue: 0,1:30:05.48,1:30:08.87,Default,,0,0,0,,客人，好爽
Dialogue: 0,1:30:19.37,1:30:23.52,Default,,0,0,0,,實在好爽
Dialogue: 0,1:30:44.62,1:30:45.98,Default,,0,0,0,,好爽
Dialogue: 0,1:31:03.81,1:31:10.12,Default,,0,0,0,,要去了
Dialogue: 0,1:31:17.60,1:31:18.92,Default,,0,0,0,,好爽
Dialogue: 0,1:31:20.24,1:31:23.67,Default,,0,0,0,,客人好讚
Dialogue: 0,1:31:25.24,1:31:31.36,Default,,0,0,0,,客人的實在好爽， 還能再來嗎？
Dialogue: 0,1:31:45.67,1:31:47.10,Default,,0,0,0,,好爽
Dialogue: 0,1:31:58.89,1:32:04.32,Default,,0,0,0,,客人的請射進來吧，去了
Dialogue: 0,1:32:09.58,1:32:12.56,Default,,0,0,0,,好讚，射好多
Dialogue: 0,1:32:40.55,1:32:45.58,Default,,0,0,0,,客人，實在好爽
Dialogue: 0,1:32:47.29,1:32:49.12,Default,,0,0,0,,客人覺得如何？
Dialogue: 0,1:32:52.43,1:32:53.64,Default,,0,0,0,,太好了
Dialogue: 0,1:32:55.40,1:32:59.07,Default,,0,0,0,,下次能再一起爽嗎？
Dialogue: 0,1:33:29.14,1:33:33.89,Default,,0,0,0,,今天非常感謝，但還有時間哦
Dialogue: 0,1:33:35.34,1:33:36.34,Default,,0,0,0,,還有嗎？
Dialogue: 0,1:33:42.63,1:33:45.14,Default,,0,0,0,,可以撒嬌一下嗎？
Dialogue: 0,1:36:15.29,1:36:16.50,Default,,0,0,0,,好爽
Dialogue: 0,1:37:59.13,1:38:00.28,Default,,0,0,0,,好爽
Dialogue: 0,1:38:06.34,1:38:07.34,Default,,0,0,0,,好讚
Dialogue: 0,1:38:34.12,1:38:35.40,Default,,0,0,0,,好爽
Dialogue: 0,1:39:04.29,1:39:06.32,Default,,0,0,0,,想要再更爽一點
Dialogue: 0,1:40:11.78,1:40:15.07,Default,,0,0,0,,客人的實在好硬
Dialogue: 0,1:40:16.43,1:40:17.77,Default,,0,0,0,,又硬起來了
Dialogue: 0,1:40:32.54,1:40:37.68,Default,,0,0,0,,客人，可以舔嗎？　　-舔吧
Dialogue: 0,1:41:58.20,1:41:59.54,Default,,0,0,0,,好讚
Dialogue: 0,1:42:36.43,1:42:39.64,Default,,0,0,0,,我的嘴爽嗎？　　-實在好爽
Dialogue: 0,1:42:41.38,1:42:43.08,Default,,0,0,0,,實在好硬
Dialogue: 0,1:43:06.02,1:43:07.48,Default,,0,0,0,,好讚
Dialogue: 0,1:43:57.94,1:44:01.33,Default,,0,0,0,,好想要客人的
Dialogue: 0,1:44:12.14,1:44:13.53,Default,,0,0,0,,給我吧
Dialogue: 0,1:44:32.38,1:44:33.75,Default,,0,0,0,,請插進來吧
Dialogue: 0,1:44:50.93,1:44:54.89,Default,,0,0,0,,客人的好爽
Dialogue: 0,1:45:08.97,1:45:14.14,Default,,0,0,0,,實在好爽　　-我也是好爽
Dialogue: 0,1:45:32.24,1:45:35.03,Default,,0,0,0,,要去了
Dialogue: 0,1:45:39.08,1:45:41.80,Default,,0,0,0,,實在好爽
Dialogue: 0,1:45:53.53,1:45:55.48,Default,,0,0,0,,看得到插入處
Dialogue: 0,1:45:58.48,1:46:00.13,Default,,0,0,0,,好爽
Dialogue: 0,1:46:07.00,1:46:08.30,Default,,0,0,0,,客人...
Dialogue: 0,1:46:34.10,1:46:35.42,Default,,0,0,0,,要去了
Dialogue: 0,1:47:18.49,1:47:19.88,Default,,0,0,0,,再來插入囉
Dialogue: 0,1:47:46.59,1:47:47.93,Default,,0,0,0,,好爽
Dialogue: 0,1:47:57.65,1:47:58.85,Default,,0,0,0,,要去了
Dialogue: 0,1:48:12.55,1:48:14.40,Default,,0,0,0,,好爽
Dialogue: 0,1:49:19.43,1:49:20.86,Default,,0,0,0,,好爽
Dialogue: 0,1:49:30.87,1:49:32.80,Default,,0,0,0,,頂到深處好爽
Dialogue: 0,1:49:42.56,1:49:43.90,Default,,0,0,0,,要去了
Dialogue: 0,1:50:04.71,1:50:07.54,Default,,0,0,0,,一直在攪動啊　　-好爽
Dialogue: 0,1:50:33.25,1:50:34.73,Default,,0,0,0,,好爽
Dialogue: 0,1:51:22.57,1:51:24.04,Default,,0,0,0,,要去了
Dialogue: 0,1:51:47.42,1:51:48.74,Default,,0,0,0,,摸我的奶
Dialogue: 0,1:52:42.98,1:52:46.92,Default,,0,0,0,,客人，實在好爽
Dialogue: 0,1:53:31.99,1:53:38.53,Default,,0,0,0,,好爽　　-客人，我也是
Dialogue: 0,1:53:43.70,1:53:44.94,Default,,0,0,0,,要去了
Dialogue: 0,1:54:13.67,1:54:16.28,Default,,0,0,0,,實在好爽
Dialogue: 0,1:54:33.30,1:54:37.61,Default,,0,0,0,,深插好爽
Dialogue: 0,1:54:56.43,1:54:57.48,Default,,0,0,0,,要不行了
Dialogue: 0,1:55:02.13,1:55:04.48,Default,,0,0,0,,實在好爽
Dialogue: 0,1:55:23.10,1:55:24.46,Default,,0,0,0,,好讚
Dialogue: 0,1:55:34.29,1:55:35.69,Default,,0,0,0,,實在好爽
Dialogue: 0,1:55:42.50,1:55:43.84,Default,,0,0,0,,好讚
Dialogue: 0,1:55:59.04,1:56:06.85,Default,,0,0,0,,要射了 - 客人的請射在裡頭吧
Dialogue: 0,1:56:10.94,1:56:13.89,Default,,0,0,0,,要去了　　-要射了
Dialogue: 0,1:56:23.00,1:56:28.49,Default,,0,0,0,,好爽，射了好多熱精
Dialogue: 0,1:57:07.21,1:57:08.56,Default,,0,0,0,,客人...
Dialogue: 0,1:57:11.15,1:57:12.89,Default,,0,0,0,,請過來吧
Dialogue: 0,1:57:45.33,1:57:49.48,Default,,0,0,0,,客人，實在好爽
Dialogue: 0,1:57:58.82,1:58:00.56,Default,,0,0,0,,實在好爽
Dialogue: 0,1:58:03.76,1:58:05.61,Default,,0,0,0,,時間已經到了呢
Dialogue: 0,1:58:07.83,1:58:10.64,Default,,0,0,0,,等您下次光臨
