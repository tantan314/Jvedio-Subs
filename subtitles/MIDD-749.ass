Dialogue: 0,0:00:02.04,0:00:09.11,Default,,0000,0000,0000,,老實說呢\N我們現在要老實說喔 -好
Dialogue: 0,0:00:10.31,0:00:17.39,Default,,0000,0000,0000,,你覺得你是主勤還是被動
Dialogue: 0,0:00:19.65,0:00:21.92,Default,,0000,0000,0000,,被動
Dialogue: 0,0:00:22.99,0:00:30.33,Default,,0000,0000,0000,,因為我很害羞嘛
Dialogue: 0,0:00:31.40,0:00:40.61,Default,,0000,0000,0000,,但是又很期待色色的事
Dialogue: 0,0:00:41.68,0:00:47.82,Default,,0000,0000,0000,,從小就很害羞嗎\N是呀
Dialogue: 0,0:00:50.22,0:00:57.43,Default,,0000,0000,0000,,這樣比較爽吧？\N可能吧
Dialogue: 0,0:01:00.63,0:01:03.03,Default,,0000,0000,0000,,我懂了
Dialogue: 0,0:01:07.30,0:01:10.51,Default,,0000,0000,0000,,什麼懂了？
Dialogue: 0,0:01:11.44,0:01:18.25,Default,,0000,0000,0000,,那麼這次呢？
Dialogue: 0,0:01:19.18,0:01:22.65,Default,,0000,0000,0000,,就做做你會害羞的事吧
Dialogue: 0,0:01:24.79,0:01:34.00,Default,,0000,0000,0000,,相澤莉娜 害羞的女孩\N雖然害羞 但又會興奮
Dialogue: 0,0:01:38.00,0:01:42.14,Default,,0000,0000,0000,,會興奮又害羞的女孩
Dialogue: 0,0:02:47.30,0:03:00.30,Default,,0000,0000,0000,,{\3c&Hffffff\c&Hff&\fn楷体\b1\fs16}《一天的不穿內衣的羞恥約會》\N{\3c&H00\c&Hffffff&\fn楷体\fs12\b1}（相澤莉娜)\N{\fntimes new roman\fs8\b1}MIDD-749\N{\c&H3ee0fd&\fs8\fn宋体}
Dialogue: 0,0:03:00.88,0:03:04.75,Default,,0000,0000,0000,,要做什麼？\N什麼喔
Dialogue: 0,0:03:06.09,0:03:10.89,Default,,0000,0000,0000,,害羞的事啊\N什麼？
Dialogue: 0,0:03:12.36,0:03:12.49,Default,,0000,0000,0000,,
Dialogue: 0,0:03:13.03,0:03:14.10,Default,,0000,0000,0000,,
Dialogue: 0,0:03:14.36,0:03:21.97,Default,,0000,0000,0000,,先隨便聊聊啊
Dialogue: 0,0:03:29.04,0:03:32.11,Default,,0000,0000,0000,,你在家會穿內衣嘴
Dialogue: 0,0:03:32.11,0:03:32.25,Default,,0000,0000,0000,,
Dialogue: 0,0:03:33.45,0:03:45.59,Default,,0000,0000,0000,,在家都是以輕鬆的打扮為主
Dialogue: 0,0:03:47.33,0:03:53.47,Default,,0000,0000,0000,,當然也不會穿內衣
Dialogue: 0,0:03:55.20,0:03:58.27,Default,,0000,0000,0000,,所以不會穿\N現在有穿吧
Dialogue: 0,0:04:01.34,0:04:01.48,Default,,0000,0000,0000,,
Dialogue: 0,0:04:01.61,0:04:04.68,Default,,0000,0000,0000,,有啊\N脫掉吧
Dialogue: 0,0:04:10.02,0:04:15.36,Default,,0000,0000,0000,,為什麼\N很怪嗎
Dialogue: 0,0:04:17.23,0:04:21.63,Default,,0000,0000,0000,,真的要嗎
Dialogue: 0,0:04:24.57,0:04:24.70,Default,,0000,0000,0000,,
Dialogue: 0,0:04:26.17,0:04:28.17,Default,,0000,0000,0000,,脫掉吧
Dialogue: 0,0:04:39.25,0:04:41.52,Default,,0000,0000,0000,,真的嗎\N對啊
Dialogue: 0,0:05:37.84,0:05:38.64,Default,,0000,0000,0000,,給我
Dialogue: 0,0:05:43.45,0:05:50.52,Default,,0000,0000,0000,,輕鬆多了吧？\N也沒有啊
Dialogue: 0,0:05:54.39,0:05:56.66,Default,,0000,0000,0000,,像這樣嗎
Dialogue: 0,0:06:01.33,0:06:07.34,Default,,0000,0000,0000,,不是緊吧？\N大概吧
Dialogue: 0,0:06:11.07,0:06:15.88,Default,,0000,0000,0000,,好可怕喔 又看不到
Dialogue: 0,0:06:18.81,0:06:22.28,Default,,0000,0000,0000,,我不知道\N像平常一樣啊
Dialogue: 0,0:06:25.49,0:06:28.29,Default,,0000,0000,0000,,大概吧
Dialogue: 0,0:06:30.16,0:06:33.76,Default,,0000,0000,0000,,有點怕怕的
Dialogue: 0,0:06:35.63,0:06:39.90,Default,,0000,0000,0000,,有點靜不下心
Dialogue: 0,0:06:56.99,0:07:01.26,Default,,0000,0000,0000,,拉起來看著要嗎
Dialogue: 0,0:07:16.61,0:07:19.01,Default,,0000,0000,0000,,可以這樣拍嗎
Dialogue: 0,0:07:33.56,0:07:35.82,Default,,0000,0000,0000,,奶很美喔
Dialogue: 0,0:07:45.97,0:07:49.04,Default,,0000,0000,0000,,自己搖一搖
Dialogue: 0,0:08:50.30,0:08:52.57,Default,,0000,0000,0000,,好軟的樣子
Dialogue: 0,0:09:01.24,0:09:05.78,Default,,0000,0000,0000,,每人這樣說過
Dialogue: 0,0:09:07.65,0:09:15.26,Default,,0000,0000,0000,,沒有人跟我請講過\N自己沒感覺嗎
Dialogue: 0,0:09:18.06,0:09:19.93,Default,,0000,0000,0000,,為什興問這個
Dialogue: 0,0:09:35.68,0:09:39.55,Default,,0000,0000,0000,,那我要確認一下
Dialogue: 0,0:10:08.51,0:10:10.25,Default,,0000,0000,0000,,好軟的樣子
Dialogue: 0,0:10:15.58,0:10:17.19,Default,,0000,0000,0000,,敏感嗎
Dialogue: 0,0:10:23.99,0:10:25.33,Default,,0000,0000,0000,,很爽
Dialogue: 0,0:10:37.21,0:10:41.34,Default,,0000,0000,0000,,有點害羞\N為什麼
Dialogue: 0,0:10:48.55,0:10:55.76,Default,,0000,0000,0000,,很怪有感覺了是嗎
Dialogue: 0,0:11:12.31,0:11:14.71,Default,,0000,0000,0000,,這樣也很爽吧
Dialogue: 0,0:11:25.65,0:11:29.26,Default,,0000,0000,0000,,很爽啊
Dialogue: 0,0:11:34.06,0:11:36.73,Default,,0000,0000,0000,,是喔
Dialogue: 0,0:11:39.80,0:11:43.67,Default,,0000,0000,0000,,是很爽啦 但好害羞
Dialogue: 0,0:11:54.08,0:11:57.69,Default,,0000,0000,0000,,爽就好啦
Dialogue: 0,0:12:03.56,0:12:04.49,Default,,0000,0000,0000,,那很棒啊
Dialogue: 0,0:12:18.77,0:12:18.91,Default,,0000,0000,0000,,
Dialogue: 0,0:12:25.58,0:12:30.92,Default,,0000,0000,0000,,要不要停旁邊
Dialogue: 0,0:12:32.39,0:12:38.13,Default,,0000,0000,0000,,停一旁\N好好的玩
Dialogue: 0,0:12:49.34,0:12:53.48,Default,,0000,0000,0000,,要不要玩
Dialogue: 0,0:12:54.81,0:12:58.15,Default,,0000,0000,0000,,玩玩軟軟的大奶
Dialogue: 0,0:12:59.48,0:13:04.95,Default,,0000,0000,0000,,在這邊檢查吧
Dialogue: 0,0:13:05.35,0:13:06.96,Default,,0000,0000,0000,,這邊嗎\N對呀
Dialogue: 0,0:13:15.23,0:13:18.03,Default,,0000,0000,0000,,好害羞 不用害羞啦
Dialogue: 0,0:13:30.85,0:13:33.25,Default,,0000,0000,0000,,怎麼樣
Dialogue: 0,0:13:37.39,0:13:38.99,Default,,0000,0000,0000,,你先躺下嘛
Dialogue: 0,0:13:48.73,0:13:49.93,Default,,0000,0000,0000,,真不錯
Dialogue: 0,0:14:15.69,0:14:17.43,Default,,0000,0000,0000,,真棒啊
Dialogue: 0,0:14:42.65,0:14:43.85,Default,,0000,0000,0000,,好軟
Dialogue: 0,0:14:49.86,0:14:53.86,Default,,0000,0000,0000,,過來點
Dialogue: 0,0:14:53.86,0:14:54.00,Default,,0000,0000,0000,,
Dialogue: 0,0:15:31.90,0:15:33.37,Default,,0000,0000,0000,,爽嗎\N嗯
Dialogue: 0,0:15:44.85,0:15:47.12,Default,,0000,0000,0000,,可以夾一下嗎
Dialogue: 0,0:15:58.99,0:16:04.47,Default,,0000,0000,0000,,夾一下嘛
Dialogue: 0,0:17:14.14,0:17:15.87,Default,,0000,0000,0000,,自己夾
Dialogue: 0,0:17:30.82,0:17:32.82,Default,,0000,0000,0000,,很爽啊
Dialogue: 0,0:17:38.96,0:17:39.76,Default,,0000,0000,0000,,真棒
Dialogue: 0,0:18:29.14,0:18:33.01,Default,,0000,0000,0000,,直接來好嗎
Dialogue: 0,0:21:46.54,0:21:48.81,Default,,0000,0000,0000,,真是對好奶子
Dialogue: 0,0:21:55.75,0:21:57.62,Default,,0000,0000,0000,,過來這邊
Dialogue: 0,0:22:08.96,0:22:15.50,Default,,0000,0000,0000,,要在這邊嗎\N對呀 好玩吧
Dialogue: 0,0:22:17.11,0:22:18.31,Default,,0000,0000,0000,,快點過來
Dialogue: 0,0:22:23.65,0:22:27.78,Default,,0000,0000,0000,,不用怕啦 來嘛
Dialogue: 0,0:22:30.85,0:22:30.99,Default,,0000,0000,0000,,
Dialogue: 0,0:22:37.93,0:22:39.39,Default,,0000,0000,0000,,摸奶呀
Dialogue: 0,0:22:47.54,0:22:51.14,Default,,0000,0000,0000,,給我有看
Dialogue: 0,0:22:55.54,0:22:56.75,Default,,0000,0000,0000,,換上這個
Dialogue: 0,0:23:07.29,0:23:10.76,Default,,0000,0000,0000,,好害羞\N沒關係
Dialogue: 0,0:23:12.09,0:23:13.83,Default,,0000,0000,0000,,沒人會來的
Dialogue: 0,0:25:13.42,0:25:14.88,Default,,0000,0000,0000,,快點換一換
Dialogue: 0,0:25:23.29,0:25:25.29,Default,,0000,0000,0000,,過去一點
Dialogue: 0,0:25:35.97,0:25:37.84,Default,,0000,0000,0000,,好害羞
Dialogue: 0,0:26:05.47,0:26:06.94,Default,,0000,0000,0000,,很興奮吧
Dialogue: 0,0:29:59.43,0:30:01.44,Default,,0000,0000,0000,,不要出聲喔
Dialogue: 0,0:42:06.70,0:42:07.36,Default,,0000,0000,0000,,
Dialogue: 0,0:42:07.50,0:42:08.70,Default,,0000,0000,0000,,撐好
Dialogue: 0,0:50:25.86,0:50:27.20,Default,,0000,0000,0000,,很爽對吧
Dialogue: 0,0:54:07.68,0:54:09.82,Default,,0000,0000,0000,,好好的含
Dialogue: 0,0:54:19.96,0:54:20.63,Default,,0000,0000,0000,,看這邊
Dialogue: 0,0:54:40.25,0:54:42.25,Default,,0000,0000,0000,,在這邊做愛了呢
Dialogue: 0,0:54:55.33,0:54:56.67,Default,,0000,0000,0000,,好爽唷
Dialogue: 0,0:55:11.08,0:55:13.08,Default,,0000,0000,0000,,怎了嗎
Dialogue: 0,0:55:37.11,0:55:42.44,Default,,0000,0000,0000,,怕人家看嗎\N也不是啦
Dialogue: 0,0:55:44.45,0:55:48.98,Default,,0000,0000,0000,,只是會害羞
Dialogue: 0,0:56:03.13,0:56:06.33,Default,,0000,0000,0000,,害羞什麼 我看
Dialogue: 0,0:56:07.94,0:56:09.54,Default,,0000,0000,0000,,不要嘛
Dialogue: 0,0:56:11.94,0:56:12.07,Default,,0000,0000,0000,,
Dialogue: 0,0:56:14.48,0:56:15.01,Default,,0000,0000,0000,,我看
Dialogue: 0,0:56:22.62,0:56:23.82,Default,,0000,0000,0000,,沒看到啊
Dialogue: 0,0:56:28.49,0:56:30.09,Default,,0000,0000,0000,,好棒喔
Dialogue: 0,0:56:55.98,0:57:00.92,Default,,0000,0000,0000,,不要太大聲啦
Dialogue: 0,0:57:11.60,0:57:12.93,Default,,0000,0000,0000,,再看一下
Dialogue: 0,0:57:22.28,0:57:24.41,Default,,0000,0000,0000,,快來玩吧
Dialogue: 0,0:57:31.35,0:57:32.82,Default,,0000,0000,0000,,這邊
Dialogue: 0,0:57:40.30,0:57:42.56,Default,,0000,0000,0000,,有人
Dialogue: 0,0:58:16.87,0:58:20.74,Default,,0000,0000,0000,,你說要到哪裏玩\N再往這邊
Dialogue: 0,0:58:47.96,0:58:50.90,Default,,0000,0000,0000,,要打嗎 會打嗎\N不會
Dialogue: 0,0:59:01.04,0:59:02.64,Default,,0000,0000,0000,,不難吧
Dialogue: 0,0:59:07.05,0:59:09.58,Default,,0000,0000,0000,,這樣嗎
Dialogue: 0,0:59:13.32,0:59:16.66,Default,,0000,0000,0000,,我教你
Dialogue: 0,0:59:26.80,0:59:28.94,Default,,0000,0000,0000,,脫了吧
Dialogue: 0,0:59:54.83,0:59:58.83,Default,,0000,0000,0000,,沒這樣打過 好怪喔
Dialogue: 0,1:00:10.05,1:00:11.91,Default,,0000,0000,0000,,這樣嗎
Dialogue: 0,1:00:18.32,1:00:20.32,Default,,0000,0000,0000,,不會啦
Dialogue: 0,1:00:24.73,1:00:27.26,Default,,0000,0000,0000,,有點怪\N是嗎
Dialogue: 0,1:00:34.60,1:00:38.87,Default,,0000,0000,0000,,要我教你嗎\N要
Dialogue: 0,1:00:47.82,1:00:51.29,Default,,0000,0000,0000,,坐那 我教你
Dialogue: 0,1:01:00.63,1:01:02.76,Default,,0000,0000,0000,,要這樣用的
Dialogue: 0,1:01:08.64,1:01:10.11,Default,,0000,0000,0000,,像這樣 騙人
Dialogue: 0,1:01:18.25,1:01:19.85,Default,,0000,0000,0000,,一定是騙人的
Dialogue: 0,1:01:24.65,1:01:27.19,Default,,0000,0000,0000,,
Dialogue: 0,1:01:28.26,1:01:35.86,Default,,0000,0000,0000,,很爽吧？\N才沒有
Dialogue: 0,1:02:46.60,1:02:47.94,Default,,0000,0000,0000,,好冰唷
Dialogue: 0,1:03:33.45,1:03:35.18,Default,,0000,0000,0000,,反應不錯喔
Dialogue: 0,1:04:20.56,1:04:23.63,Default,,0000,0000,0000,,剛剛有點教錯了
Dialogue: 0,1:04:34.18,1:04:35.51,Default,,0000,0000,0000,,這什麼？
Dialogue: 0,1:05:57.99,1:05:58.93,Default,,0000,0000,0000,,有人
Dialogue: 0,1:05:59.06,1:05:59.19,Default,,0000,0000,0000,,
Dialogue: 0,1:06:11.34,1:06:13.21,Default,,0000,0000,0000,,不用怕的
Dialogue: 0,1:06:18.15,1:06:19.88,Default,,0000,0000,0000,,一直坐在這吧
Dialogue: 0,1:06:27.62,1:06:28.82,Default,,0000,0000,0000,,不要啦
Dialogue: 0,1:10:39.88,1:10:41.61,Default,,0000,0000,0000,,不要在這了啦
Dialogue: 0,1:10:56.69,1:10:58.83,Default,,0000,0000,0000,,好吧
Dialogue: 0,1:11:06.30,1:11:07.37,Default,,0000,0000,0000,,走吧
Dialogue: 0,1:11:19.92,1:11:22.05,Default,,0000,0000,0000,,換地方吧
Dialogue: 0,1:11:33.66,1:11:35.00,Default,,0000,0000,0000,,好了 走
Dialogue: 0,1:56:42.77,1:56:46.11,Default,,0000,0000,0000,,
Dialogue: 0,1:56:59.72,1:57:09.46,Default,,0000,0000,0000,,今天玩了很之不一樣的喔\N好害羞 害羞喔
Dialogue: 0,1:57:12.80,1:57:17.34,Default,,0000,0000,0000,,害羞也很棒啊
Dialogue: 0,1:57:18.67,1:57:24.55,Default,,0000,0000,0000,,嗯 很爽
Dialogue: 0,1:57:38.69,1:57:45.50,Default,,0000,0000,0000,,這次做了這麼多害羞的事\N怎麼樣
Dialogue: 0,1:57:49.24,1:57:54.98,Default,,0000,0000,0000,,又害羞又爽
Dialogue: 0,1:57:56.71,1:58:01.92,Default,,0000,0000,0000,,跟你一開始說的一樣呢
Dialogue: 0,1:58:03.12,1:58:06.86,Default,,0000,0000,0000,,雖然害羞但又爽\N對呀
Dialogue: 0,1:58:09.12,1:58:15.93,Default,,0000,0000,0000,,下一次要不要玩更刺激的
Dialogue: 0,1:58:18.07,1:58:21.27,Default,,0000,0000,0000,,好的
Dialogue: 0,1:58:24.74,1:58:28.74,Default,,0000,0000,0000,,辛苦你了 -你也是 -謝謝

