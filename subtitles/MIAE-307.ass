Dialogue: 0,0:31:46.90,0:31:47.90,Default,,0,0,0,,上廁所嗎
Dialogue: 0,0:31:48.90,0:31:49.20,Default,,0,0,0,,是的
Dialogue: 0,0:31:50.70,0:31:52.30,Default,,0,0,0,,廁所嗎
Dialogue: 0,0:31:58.20,0:32:00.50,Default,,0,0,0,,不是尿尿
Dialogue: 0,0:32:07.50,0:32:10.20,Default,,0,0,0,,其實去廁所要做別的事情吧
Dialogue: 0,0:32:14.00,0:32:15.30,Default,,0,0,0,,怎麼樣
Dialogue: 0,0:32:17.70,0:32:19.09,Default,,0,0,0,,這個
Dialogue: 0,0:32:20.88,0:32:23.20,Default,,0,0,0,,這是什麼
Dialogue: 0,0:32:29.90,0:32:30.70,Default,,0,0,0,,不行的吧
Dialogue: 0,0:32:32.90,0:32:35.79,Default,,0,0,0,,在走廊亂跑的壞孩子
Dialogue: 0,0:32:37.50,0:32:39.40,Default,,0,0,0,,需要懲罰呢
Dialogue: 0,0:32:45.23,0:32:46.59,Default,,0,0,0,,老師
Dialogue: 0,0:33:05.49,0:33:07.33,Default,,0,0,0,,-要懲罰哦 -好的
Dialogue: 0,0:33:29.00,0:33:29.70,Default,,0,0,0,,舌頭伸出來
Dialogue: 0,0:33:31.83,0:33:32.94,Default,,0,0,0,,沒錯
Dialogue: 0,0:33:56.47,0:33:58.00,Default,,0,0,0,,變硬了呢
Dialogue: 0,0:34:01.90,0:34:03.90,Default,,0,0,0,,看了老師的胸部
Dialogue: 0,0:34:04.29,0:34:06.20,Default,,0,0,0,,興奮了嗎
Dialogue: 0,0:34:07.10,0:34:08.70,Default,,0,0,0,,你絶對看了吧
Dialogue: 0,0:34:37.00,0:34:38.18,Default,,0,0,0,,這樣舒服吧
Dialogue: 0,0:34:56.50,0:34:58.66,Default,,0,0,0,,勃起得那麼厲害
Dialogue: 0,0:35:00.00,0:35:02.00,Default,,0,0,0,,這裡也要懲罰呢
Dialogue: 0,0:35:08.61,0:35:10.94,Default,,0,0,0,,讓老師看看
Dialogue: 0,0:35:29.69,0:35:31.50,Default,,0,0,0,,這裡很厲害了哦
Dialogue: 0,0:35:33.00,0:35:34.40,Default,,0,0,0,,對不起
Dialogue: 0,0:35:36.43,0:35:39.50,Default,,0,0,0,,肉棒在動了哦
Dialogue: 0,0:35:43.46,0:35:44.86,Default,,0,0,0,,讓我看
Dialogue: 0,0:35:48.59,0:35:49.94,Default,,0,0,0,,好厲害
Dialogue: 0,0:35:55.59,0:35:57.50,Default,,0,0,0,,舒服嗎
Dialogue: 0,0:36:03.94,0:36:12.09,Default,,0,0,0,,-老師\N-老師的唾液都弄到肉棒上了
Dialogue: 0,0:36:18.30,0:36:20.40,Default,,0,0,0,,舒服嗎
Dialogue: 0,0:36:21.00,0:36:21.59,Default,,0,0,0,,好厲害
Dialogue: 0,0:37:00.00,0:37:01.40,Default,,0,0,0,,好硬
Dialogue: 0,0:37:05.09,0:37:07.50,Default,,0,0,0,,-興奮嗎 -是的
Dialogue: 0,0:37:21.20,0:37:22.09,Default,,0,0,0,,都這樣了
Dialogue: 0,0:37:25.59,0:37:29.74,Default,,0,0,0,,-想看老師的胸部吧\N-是的
Dialogue: 0,0:37:31.50,0:37:31.90,Default,,0,0,0,,真的嗎
Dialogue: 0,0:37:33.59,0:37:34.00,Default,,0,0,0,,是的
Dialogue: 0,0:37:37.40,0:37:42.80,Default,,0,0,0,,真沒有辦法啊 讓你看看吧
Dialogue: 0,0:37:54.00,0:37:56.30,Default,,0,0,0,,想要看吧
Dialogue: 0,0:38:06.80,0:38:08.20,Default,,0,0,0,,出來了
Dialogue: 0,0:38:09.00,0:38:10.50,Default,,0,0,0,,老師的胸部
Dialogue: 0,0:38:15.53,0:38:17.00,Default,,0,0,0,,-摸一下 -好
Dialogue: 0,0:38:47.13,0:38:52.59,Default,,0,0,0,,柔軟吧 隨便摸吧
Dialogue: 0,0:38:55.00,0:38:57.90,Default,,0,0,0,,老師也興奮了
Dialogue: 0,0:39:00.40,0:39:01.70,Default,,0,0,0,,濕透了
Dialogue: 0,0:39:03.40,0:39:04.59,Default,,0,0,0,,摸一下吧
Dialogue: 0,0:39:06.50,0:39:07.09,Default,,0,0,0,,好的
Dialogue: 0,0:39:39.73,0:39:44.56,Default,,0,0,0,,-老師的小穴\N-好厲害 好熱
Dialogue: 0,0:39:45.82,0:39:47.53,Default,,0,0,0,,好舒服
Dialogue: 0,0:39:49.99,0:39:51.34,Default,,0,0,0,,繼續摸
Dialogue: 0,0:39:55.00,0:39:56.40,Default,,0,0,0,,對
Dialogue: 0,0:40:01.30,0:40:01.90,Default,,0,0,0,,好厲害
Dialogue: 0,0:40:03.00,0:40:03.30,Default,,0,0,0,,好厲害
Dialogue: 0,0:40:03.80,0:40:04.70,Default,,0,0,0,,老師
Dialogue: 0,0:40:24.80,0:40:29.71,Default,,0,0,0,,-小穴濕透了吧\N-好厲害 濕透了
Dialogue: 0,0:40:33.22,0:40:34.91,Default,,0,0,0,,這不是懲罰吧
Dialogue: 0,0:40:39.00,0:40:42.80,Default,,0,0,0,,-要繼續摸肉棒了\N-好的
Dialogue: 0,0:40:54.50,0:40:56.70,Default,,0,0,0,,用老師的屁股
Dialogue: 0,0:41:03.60,0:41:04.30,Default,,0,0,0,,繼續摩擦
Dialogue: 0,0:41:16.54,0:41:19.06,Default,,0,0,0,,好厲害 舒服吧
Dialogue: 0,0:41:25.20,0:41:26.30,Default,,0,0,0,,-舒服嗎 -是的
Dialogue: 0,0:41:33.93,0:41:34.95,Default,,0,0,0,,好熱
Dialogue: 0,0:41:48.70,0:41:51.28,Default,,0,0,0,,好厲害 濕透了
Dialogue: 0,0:41:59.47,0:42:02.30,Default,,0,0,0,,-這裡嗎 -好厲害
Dialogue: 0,0:42:22.60,0:42:24.40,Default,,0,0,0,,舒服嗎
Dialogue: 0,0:42:30.70,0:42:31.70,Default,,0,0,0,,老師的
Dialogue: 0,0:42:34.99,0:42:38.69,Default,,0,0,0,,淫水 弄上去吧
Dialogue: 0,0:42:39.10,0:42:40.00,Default,,0,0,0,,好厲害
Dialogue: 0,0:43:01.31,0:43:02.50,Default,,0,0,0,,這樣嗎
Dialogue: 0,0:43:05.50,0:43:06.10,Default,,0,0,0,,濕透了
Dialogue: 0,0:43:49.28,0:43:50.54,Default,,0,0,0,,好舒服
Dialogue: 0,0:44:30.01,0:44:36.00,Default,,0,0,0,,-老師好舒服\N-射出來 射出來
Dialogue: 0,0:44:47.03,0:44:49.24,Default,,0,0,0,,老師 好舒服
Dialogue: 0,0:44:53.43,0:44:55.70,Default,,0,0,0,,射了很多呢
Dialogue: 0,0:45:18.13,0:45:19.70,Default,,0,0,0,,太好吃了
Dialogue: 0,0:45:34.42,0:45:35.49,Default,,0,0,0,,老師
Dialogue: 0,0:45:39.53,0:45:43.94,Default,,0,0,0,,-不可以亂跑哦 明白了嗎\N-是的
Dialogue: 0,0:45:45.40,0:45:46.40,Default,,0,0,0,,那就好
Dialogue: 0,0:45:53.36,0:45:59.30,Default,,0,0,0,,（第三小時 輔導員和）\N（老師的不純異性交往）
Dialogue: 0,0:46:12.50,0:46:23.48,Default,,0,0,0,,（不純異性交往）
Dialogue: 0,0:46:23.50,0:46:24.69,Default,,0,0,0,,老師
Dialogue: 0,0:46:25.09,0:46:26.80,Default,,0,0,0,,生活指導
Dialogue: 0,0:46:27.09,0:46:29.90,Default,,0,0,0,,你要多思考\N不純異性交往的問題
Dialogue: 0,0:46:30.80,0:46:34.60,Default,,0,0,0,,你覺得怎麼樣才算是\N不純異性交往
Dialogue: 0,0:46:36.80,0:46:41.69,Default,,0,0,0,,學生之間在外面過夜\N也算吧
Dialogue: 0,0:46:43.30,0:46:45.19,Default,,0,0,0,,只是過夜嗎
Dialogue: 0,0:46:45.69,0:46:48.19,Default,,0,0,0,,我不想太嚴格
Dialogue: 0,0:46:50.50,0:46:54.00,Default,,0,0,0,,不過學校不承認這種\N不健全的行為
Dialogue: 0,0:46:55.09,0:46:55.80,Default,,0,0,0,,不健全嗎
Dialogue: 0,0:46:57.50,0:46:58.20,Default,,0,0,0,,不健全
Dialogue: 0,0:47:06.10,0:47:07.20,Default,,0,0,0,,這樣嗎
Dialogue: 0,0:47:12.90,0:47:14.50,Default,,0,0,0,,不對嗎
Dialogue: 0,0:47:19.30,0:47:24.52,Default,,0,0,0,,不健
Dialogue: 0,0:47:35.09,0:47:35.59,Default,,0,0,0,,不
Dialogue: 0,0:47:38.60,0:47:39.10,Default,,0,0,0,,健
Dialogue: 0,0:47:41.54,0:47:43.00,Default,,0,0,0,,怎樣寫的
Dialogue: 0,0:47:45.18,0:47:49.70,Default,,0,0,0,,健 健
Dialogue: 0,0:47:55.94,0:47:58.14,Default,,0,0,0,,好像寫錯了
Dialogue: 0,0:48:02.63,0:48:09.40,Default,,0,0,0,,好了 太嚴格對教育不好
Dialogue: 0,0:48:09.90,0:48:13.10,Default,,0,0,0,,外國接吻和擁抱都很平常
Dialogue: 0,0:48:14.00,0:48:16.09,Default,,0,0,0,,所以我想要
Dialogue: 0,0:48:16.40,0:48:18.50,Default,,0,0,0,,明確地說明什麼可以什麼不行
Dialogue: 0,0:48:19.80,0:48:21.19,Default,,0,0,0,,的確是呢
Dialogue: 0,0:48:22.59,0:48:23.80,Default,,0,0,0,,老師
Dialogue: 0,0:48:24.40,0:48:25.40,Default,,0,0,0,,過來這裡
Dialogue: 0,0:48:26.80,0:48:27.70,Default,,0,0,0,,好的
Dialogue: 0,0:48:34.95,0:48:37.59,Default,,0,0,0,,-老師 -是
Dialogue: 0,0:48:38.59,0:48:39.50,Default,,0,0,0,,擁抱
Dialogue: 0,0:48:43.00,0:48:43.30,Default,,0,0,0,,怎麼樣
Dialogue: 0,0:48:43.90,0:48:45.19,Default,,0,0,0,,是打招呼的方式吧
Dialogue: 0,0:48:47.10,0:48:48.90,Default,,0,0,0,,是的
Dialogue: 0,0:48:49.80,0:48:50.40,Default,,0,0,0,,的確呢
Dialogue: 0,0:48:51.00,0:48:51.80,Default,,0,0,0,,對吧
Dialogue: 0,0:48:52.40,0:48:53.09,Default,,0,0,0,,是的
Dialogue: 0,0:48:53.50,0:48:54.90,Default,,0,0,0,,明白了
Dialogue: 0,0:48:55.20,0:48:56.10,Default,,0,0,0,,那麼
Dialogue: 0,0:48:56.40,0:48:58.90,Default,,0,0,0,,擁抱
Dialogue: 0,0:48:59.30,0:49:01.70,Default,,0,0,0,,就是允許的
Dialogue: 0,0:49:04.50,0:49:05.59,Default,,0,0,0,,那麼接下來
Dialogue: 0,0:49:21.09,0:49:22.00,Default,,0,0,0,,接吻
Dialogue: 0,0:49:22.69,0:49:24.19,Default,,0,0,0,,也是打招呼的當時對吧
Dialogue: 0,0:49:26.30,0:49:27.59,Default,,0,0,0,,是的
Dialogue: 0,0:49:27.90,0:49:28.30,Default,,0,0,0,,沒錯
Dialogue: 0,0:49:28.88,0:49:30.74,Default,,0,0,0,,的確
Dialogue: 0,0:49:33.43,0:49:34.70,Default,,0,0,0,,接吻
Dialogue: 0,0:49:44.60,0:49:45.50,Default,,0,0,0,,是
Dialogue: 0,0:49:46.70,0:49:48.00,Default,,0,0,0,,老師
Dialogue: 0,0:49:51.50,0:49:52.00,Default,,0,0,0,,你幹什麼
Dialogue: 0,0:49:53.80,0:49:58.90,Default,,0,0,0,,-硬了嗎 -沒有
Dialogue: 0,0:49:59.60,0:50:02.10,Default,,0,0,0,,-老師 -不對的
Dialogue: 0,0:50:04.40,0:50:05.20,Default,,0,0,0,,這個
Dialogue: 0,0:50:09.03,0:50:11.50,Default,,0,0,0,,-抱歉 -好硬
Dialogue: 0,0:50:13.30,0:50:14.09,Default,,0,0,0,,-老師 -是
Dialogue: 0,0:50:15.20,0:50:16.60,Default,,0,0,0,,不行吧
Dialogue: 0,0:50:17.69,0:50:20.50,Default,,0,0,0,,身為輔導員
Dialogue: 0,0:50:22.30,0:50:24.00,Default,,0,0,0,,自己都那麼硬的話
Dialogue: 0,0:50:26.80,0:50:27.91,Default,,0,0,0,,對不起
Dialogue: 0,0:50:29.80,0:50:30.90,Default,,0,0,0,,沒事的哦
Dialogue: 0,0:50:34.10,0:50:35.10,Default,,0,0,0,,我會注意的
Dialogue: 0,0:50:37.09,0:50:38.00,Default,,0,0,0,,老師
Dialogue: 0,0:50:53.86,0:50:55.10,Default,,0,0,0,,老師
Dialogue: 0,0:51:09.19,0:51:11.00,Default,,0,0,0,,-老師 -是
Dialogue: 0,0:51:11.80,0:51:12.80,Default,,0,0,0,,現在
Dialogue: 0,0:51:14.19,0:51:15.69,Default,,0,0,0,,做一些
Dialogue: 0,0:51:16.90,0:51:17.50,Default,,0,0,0,,不允許的事情吧
Dialogue: 0,0:51:20.03,0:51:21.33,Default,,0,0,0,,好的
Dialogue: 0,0:51:22.03,0:51:30.80,Default,,0,0,0,,-要體驗一下學生犯規的感覺\N-很關心學生呢
Dialogue: 0,0:51:31.30,0:51:33.19,Default,,0,0,0,,真不錯
Dialogue: 0,0:51:35.20,0:51:36.20,Default,,0,0,0,,那麼
Dialogue: 0,0:51:37.00,0:51:38.50,Default,,0,0,0,,那麼
Dialogue: 0,0:51:38.80,0:51:39.59,Default,,0,0,0,,開始違規吧
Dialogue: 0,0:51:40.90,0:51:41.60,Default,,0,0,0,,好的
Dialogue: 0,0:52:01.40,0:52:04.30,Default,,0,0,0,,褲子 要脫掉嗎
Dialogue: 0,0:52:08.40,0:52:08.80,Default,,0,0,0,,快點
Dialogue: 0,0:52:10.00,0:52:11.20,Default,,0,0,0,,好的
Dialogue: 0,0:52:17.00,0:52:18.30,Default,,0,0,0,,好厲害
Dialogue: 0,0:52:18.60,0:52:26.70,Default,,0,0,0,,-對不起\N-老師怎麼這樣了 不行的吧
Dialogue: 0,0:52:28.40,0:52:29.70,Default,,0,0,0,,老師
Dialogue: 0,0:52:30.19,0:52:31.69,Default,,0,0,0,,看不到裡面
Dialogue: 0,0:52:32.20,0:52:34.30,Default,,0,0,0,,-這個也脫掉吧 -這個嗎
Dialogue: 0,0:52:39.10,0:52:40.80,Default,,0,0,0,,好厲害
Dialogue: 0,0:52:45.30,0:52:46.00,Default,,0,0,0,,好熱
Dialogue: 0,0:52:46.90,0:52:48.20,Default,,0,0,0,,都那麼熱呢
Dialogue: 0,0:52:53.80,0:52:58.70,Default,,0,0,0,,-好厲害 -對不起
Dialogue: 0,0:53:00.58,0:53:01.33,Default,,0,0,0,,沒錯哦
Dialogue: 0,0:53:02.80,0:53:05.50,Default,,0,0,0,,不行的 老師
Dialogue: 0,0:53:14.82,0:53:15.60,Default,,0,0,0,,好厲害
Dialogue: 0,0:53:24.50,0:53:30.34,Default,,0,0,0,,-老師 那裡 -哪裡
Dialogue: 0,0:53:30.36,0:53:31.97,Default,,0,0,0,,太舒服了
Dialogue: 0,0:53:34.69,0:53:35.90,Default,,0,0,0,,老師
Dialogue: 0,0:53:36.20,0:53:37.22,Default,,0,0,0,,我也
Dialogue: 0,0:53:38.00,0:53:40.90,Default,,0,0,0,,看了你的肉棒
Dialogue: 0,0:53:41.60,0:53:42.20,Default,,0,0,0,,我也興奮了
Dialogue: 0,0:54:00.10,0:54:01.80,Default,,0,0,0,,不行
Dialogue: 0,0:54:08.00,0:54:09.30,Default,,0,0,0,,要高潮了
Dialogue: 0,0:54:37.80,0:54:39.50,Default,,0,0,0,,濕透了
Dialogue: 0,0:54:40.50,0:54:46.50,Default,,0,0,0,,-老師 怎麼辦啊 -是的
Dialogue: 0,0:54:47.19,0:54:49.00,Default,,0,0,0,,-老師 -是
Dialogue: 0,0:54:49.70,0:54:52.40,Default,,0,0,0,,你要怎麼解決啊
Dialogue: 0,0:54:53.30,0:54:54.66,Default,,0,0,0,,對不起
Dialogue: 0,0:54:55.60,0:54:57.70,Default,,0,0,0,,都濕透了哦
Dialogue: 0,0:55:02.30,0:55:04.20,Default,,0,0,0,,-老師 -是的
Dialogue: 0,0:55:06.20,0:55:08.40,Default,,0,0,0,,可以給我弄乾淨嗎
Dialogue: 0,0:55:24.51,0:55:28.96,Default,,0,0,0,,-好厲害 繼續舔哦 -好的
Dialogue: 0,0:55:31.41,0:55:35.80,Default,,0,0,0,,太興奮了 好厲害
Dialogue: 0,0:55:43.50,0:55:44.60,Default,,0,0,0,,好厲害
Dialogue: 0,0:55:51.13,0:55:56.68,Default,,0,0,0,,好厲害 老師的舌頭 好舒服
Dialogue: 0,0:56:05.12,0:56:06.25,Default,,0,0,0,,要高潮了
Dialogue: 0,0:56:26.70,0:56:27.70,Default,,0,0,0,,好舒服
Dialogue: 0,0:56:28.69,0:56:29.09,Default,,0,0,0,,好厲害
Dialogue: 0,0:56:29.70,0:56:31.20,Default,,0,0,0,,謝謝
Dialogue: 0,0:56:42.30,0:56:49.40,Default,,0,0,0,,-那麼我就這樣\N-不行的 我也讓你
Dialogue: 0,0:56:54.30,0:56:55.52,Default,,0,0,0,,舒服吧
Dialogue: 0,0:57:01.20,0:57:02.50,Default,,0,0,0,,老師
Dialogue: 0,0:57:04.50,0:57:06.60,Default,,0,0,0,,很厲害哦
Dialogue: 0,0:57:07.80,0:57:11.19,Default,,0,0,0,,-老師 -好硬
Dialogue: 0,0:57:17.59,0:57:18.19,Default,,0,0,0,,脫掉吧
Dialogue: 0,0:57:19.00,0:57:21.70,Default,,0,0,0,,-不行 -什麼不行
Dialogue: 0,0:57:22.60,0:57:24.60,Default,,0,0,0,,不行的
Dialogue: 0,0:57:30.30,0:57:32.11,Default,,0,0,0,,好厲害
Dialogue: 0,0:57:36.60,0:57:37.90,Default,,0,0,0,,-集中一點 -好的
Dialogue: 0,0:57:59.10,0:58:00.70,Default,,0,0,0,,可以的吧
Dialogue: 0,0:58:02.82,0:58:07.98,Default,,0,0,0,,好厲害 肉棒 好硬
