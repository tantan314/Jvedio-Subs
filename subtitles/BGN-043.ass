Dialogue: 0,0:00:22.22,0:00:27.46,Default,,0,0,0,,大日向遥 21岁
Dialogue: 0,0:00:52.02,0:00:54.95,Default,,0,0,0,,2017年东京练马区某摄影棚
Dialogue: 0,0:00:56.82,0:01:04.03,Default,,0,0,0,,早上好 早上好
Dialogue: 0,0:01:08.90,0:01:14.81,Default,,0,0,0,,没有其他人在 真的啊
Dialogue: 0,0:01:14.91,0:01:22.71,Default,,0,0,0,,感觉怎么样
Dialogue: 0,0:01:22.82,0:01:27.02,Default,,0,0,0,,昨天拍了吗 没有
Dialogue: 0,0:01:27.12,0:01:32.83,Default,,0,0,0,,感觉怎么样
Dialogue: 0,0:01:32.93,0:01:38.53,Default,,0,0,0,,超级紧张 紧张啊
Dialogue: 0,0:01:43.90,0:01:51.81,Default,,0,0,0,,挺喜欢这个的 这样啊
Dialogue: 0,0:01:51.91,0:01:54.91,Default,,0,0,0,,喜欢是喜欢
Dialogue: 0,0:01:55.01,0:01:59.22,Default,,0,0,0,,在车里 真的吗
Dialogue: 0,0:01:59.32,0:02:05.02,Default,,0,0,0,,什么时候 昨天晚上
Dialogue: 0,0:02:05.13,0:02:13.70,Default,,0,0,0,,今天就这样收拾一下来了
Dialogue: 0,0:02:13.80,0:02:20.21,Default,,0,0,0,,昨天晚上很累
Dialogue: 0,0:02:20.31,0:02:25.61,Default,,0,0,0,,现在呢 有没有想要尝试的东西
Dialogue: 0,0:02:25.71,0:02:32.92,Default,,0,0,0,,我知道了 可以吗 ok
Dialogue: 0,0:02:33.02,0:02:39.53,Default,,0,0,0,,好厉害
Dialogue: 0,0:02:43.33,0:02:52.80,Default,,0,0,0,,睡袍很适合你啊 是吗 谢谢
Dialogue: 0,0:02:56.31,0:03:01.51,Default,,0,0,0,,换好了
Dialogue: 0,0:03:01.61,0:03:07.52,Default,,0,0,0,,让我看一下 啊取下来比较好
Dialogue: 0,0:03:36.42,0:03:46.02,Default,,0,0,0,,已经习惯了是吧 诶\N真的吗 为什么这么擅长呢
Dialogue: 0,0:03:46.13,0:03:51.93,Default,,0,0,0,,真的吗 真的很厉害啊
Dialogue: 0,0:03:52.03,0:04:01.21,Default,,0,0,0,,照片怎么样 我也不知道\N应该没事吧
Dialogue: 0,0:04:01.31,0:04:06.51,Default,,0,0,0,,谁 这种感觉
Dialogue: 0,0:04:06.61,0:04:15.92,Default,,0,0,0,,有一种想亏涧的感觉
Dialogue: 0,0:04:30.80,0:04:36.91,Default,,0,0,0,,这种感觉 好厉害\N感觉怎么样
Dialogue: 0,0:04:37.01,0:04:39.21,Default,,0,0,0,,可爱
Dialogue: 0,0:04:39.31,0:04:42.85,Default,,0,0,0,,有花吧 嗯 感觉不错
Dialogue: 0,0:04:43.28,0:04:45.12,Default,,0,0,0,,有花吧 嗯 感觉不错
Dialogue: 0,0:04:46.42,0:04:53.73,Default,,0,0,0,,今天 有一个欢迎一起出道的女孩
Dialogue: 0,0:04:53.83,0:05:01.70,Default,,0,0,0,,不好意思
Dialogue: 0,0:05:01.80,0:05:11.21,Default,,0,0,0,,你知道是做什么吗 知道\N感觉怎么样 很紧张
Dialogue: 0,0:05:18.22,0:05:22.62,Default,,0,0,0,,今天要在摄影棚拍摄
Dialogue: 0,0:05:22.72,0:05:29.73,Default,,0,0,0,,没有经历过这种事
Dialogue: 0,0:05:29.83,0:05:33.13,Default,,0,0,0,,也不是打招呼什么的
Dialogue: 0,0:05:33.23,0:05:38.40,Default,,0,0,0,,第一次见面什么的
Dialogue: 0,0:05:38.50,0:05:43.21,Default,,0,0,0,,你可以去一下吗 好的
Dialogue: 0,0:05:43.31,0:05:52.12,Default,,0,0,0,,感觉怎么样 还行吗 嗯
Dialogue: 0,0:05:52.22,0:05:58.12,Default,,0,0,0,,就在旁边 哦
Dialogue: 0,0:06:07.00,0:06:15.01,Default,,0,0,0,,麻烦你了 没什么
Dialogue: 0,0:06:15.11,0:06:21.51,Default,,0,0,0,,感觉很不可思议吗 没有
Dialogue: 0,0:06:26.52,0:06:35.13,Default,,0,0,0,,麻烦你了
Dialogue: 0,0:06:35.23,0:06:45.00,Default,,0,0,0,,那个
Dialogue: 0,0:06:45.10,0:06:47.87,Default,,0,0,0,,在那
Dialogue: 0,0:06:49.64,0:06:50.11,Default,,0,0,0,,在那
Dialogue: 0,0:06:50.21,0:06:51.91,Default,,0,0,0,,很认生吗
Dialogue: 0,0:06:52.01,0:07:00.72,Default,,0,0,0,,嗯 认生啊
Dialogue: 0,0:07:00.82,0:07:09.03,Default,,0,0,0,,那样是关
Dialogue: 0,0:07:09.13,0:07:11.53,Default,,0,0,0,,打扰了
Dialogue: 0,0:07:11.63,0:07:15.00,Default,,0,0,0,,你好
Dialogue: 0,0:07:17.70,0:07:20.11,Default,,0,0,0,,难得有机会
Dialogue: 0,0:07:20.21,0:07:25.11,Default,,0,0,0,,想着两个人打招呼什么的
Dialogue: 0,0:07:25.21,0:07:30.82,Default,,0,0,0,,就把她叫过来了
Dialogue: 0,0:07:35.52,0:07:45.13,Default,,0,0,0,,她是第一次拍 啊 感觉怎么样
Dialogue: 0,0:07:46.93,0:07:52.80,Default,,0,0,0,,很紧张
Dialogue: 0,0:07:54.01,0:08:03.72,Default,,0,0,0,,我可以坐下吗 可以\N不知道该说什么好啊 对啊
Dialogue: 0,0:08:08.62,0:08:16.53,Default,,0,0,0,,来个自我介绍什么的
Dialogue: 0,0:08:32.81,0:08:36.01,Default,,0,0,0,,你多大了
Dialogue: 0,0:08:44.92,0:08:47.63,Default,,0,0,0,,这个感觉啊
Dialogue: 0,0:08:49.53,0:08:57.80,Default,,0,0,0,,怎么了 没什么
Dialogue: 0,0:08:57.90,0:09:03.21,Default,,0,0,0,,最后了
Dialogue: 0,0:09:03.31,0:09:08.21,Default,,0,0,0,,拜托了 总有这种感觉
Dialogue: 0,0:09:08.31,0:09:18.12,Default,,0,0,0,,拜托了
Dialogue: 0,0:09:20.43,0:09:29.80,Default,,0,0,0,,不好意思
Dialogue: 0,0:09:34.01,0:09:39.14,Default,,0,0,0,,失礼了
Dialogue: 0,0:09:39.51,0:09:39.91,Default,,0,0,0,,失礼了
Dialogue: 0,0:09:40.01,0:09:44.25,Default,,0,0,0,,谢谢
Dialogue: 0,0:09:50.32,0:09:56.23,Default,,0,0,0,,我会加油的
Dialogue: 0,0:09:56.33,0:10:01.90,Default,,0,0,0,,感觉怎么样
Dialogue: 0,0:10:02.00,0:10:05.50,Default,,0,0,0,,和想象的感觉不一样
Dialogue: 0,0:10:05.61,0:10:10.61,Default,,0,0,0,,很成熟也很美 真的吗
Dialogue: 0,0:10:10.71,0:10:19.72,Default,,0,0,0,,来句有干劲的吧
Dialogue: 0,0:10:19.82,0:10:21.62,Default,,0,0,0,,没事
Dialogue: 0,0:10:21.72,0:10:31.13,Default,,0,0,0,,什么呢
Dialogue: 0,0:10:31.23,0:10:37.90,Default,,0,0,0,,为了让大家看到更多的
Dialogue: 0,0:10:39.51,0:10:45.31,Default,,0,0,0,,我会加油的
Dialogue: 0,0:10:45.41,0:10:55.42,Default,,0,0,0,,加油 谢谢 麻烦你了
Dialogue: 0,0:11:08.30,0:11:15.21,Default,,0,0,0,,不好意思没告诉你\N想着打个招呼
Dialogue: 0,0:11:15.31,0:11:19.31,Default,,0,0,0,,这样啊
Dialogue: 0,0:11:19.41,0:11:24.02,Default,,0,0,0,,说你很漂亮
Dialogue: 0,0:11:24.12,0:11:30.22,Default,,0,0,0,,感觉和我不是一个类型的 是吗
Dialogue: 0,0:11:32.53,0:11:41.80,Default,,0,0,0,,没有这样的朋友 没有\N吓我一跳
Dialogue: 0,0:11:49.91,0:11:54.11,Default,,0,0,0,,休息日做什么呢
Dialogue: 0,0:11:54.21,0:12:00.12,Default,,0,0,0,,感觉没什么特别的
Dialogue: 0,0:12:00.22,0:12:07.63,Default,,0,0,0,,喜欢锻炼身体 是吗 做什么呢\N瑜伽什么的
Dialogue: 0,0:12:07.73,0:12:10.73,Default,,0,0,0,,这样啊 嗯
Dialogue: 0,0:12:10.83,0:12:18.00,Default,,0,0,0,,做些什么呢 往前伸身体什么的可以
Dialogue: 0,0:12:18.10,0:12:21.61,Default,,0,0,0,,为什么喜欢做瑜伽呢
Dialogue: 0,0:12:21.71,0:12:23.61,Default,,0,0,0,,为什么呢
Dialogue: 0,0:12:23.71,0:12:29.11,Default,,0,0,0,,嗯怎么说呢
Dialogue: 0,0:12:29.22,0:12:37.02,Default,,0,0,0,,比较流行什么的
Dialogue: 0,0:12:37.12,0:12:42.03,Default,,0,0,0,,喜欢大家喜欢做的啊 是的
Dialogue: 0,0:12:42.13,0:12:47.70,Default,,0,0,0,,喜欢这样的啊
Dialogue: 0,0:12:47.80,0:12:51.60,Default,,0,0,0,,会对流行的东西感兴趣 对
Dialogue: 0,0:12:51.70,0:12:55.01,Default,,0,0,0,,去年有吗
Dialogue: 0,0:12:55.11,0:12:56.71,Default,,0,0,0,,那个
Dialogue: 0,0:12:56.81,0:13:01.71,Default,,0,0,0,,去年去健身房
Dialogue: 0,0:13:01.81,0:13:04.22,Default,,0,0,0,,还有什么呢
Dialogue: 0,0:13:04.32,0:13:12.62,Default,,0,0,0,,还有那个流行的 在做呢 是啊
Dialogue: 0,0:13:15.63,0:13:25.10,Default,,0,0,0,,那像美容什么的也有兴趣 是的
Dialogue: 0,0:13:25.20,0:13:27.81,Default,,0,0,0,,认识的女性里
Dialogue: 0,0:13:27.91,0:13:37.92,Default,,0,0,0,,会有想成为的吗 嗯 有
Dialogue: 0,0:13:38.02,0:13:41.62,Default,,0,0,0,,好就这样吧 就是这种感觉
Dialogue: 0,0:13:54.13,0:13:58.00,Default,,0,0,0,,挺好的啊
Dialogue: 0,0:13:58.10,0:14:01.41,Default,,0,0,0,,现在
Dialogue: 0,0:14:01.51,0:14:10.32,Default,,0,0,0,,在工作 这样啊
Dialogue: 0,0:14:10.42,0:14:14.69,Default,,0,0,0,,现在穿的不是那个
Dialogue: 0,0:14:15.02,0:14:17.22,Default,,0,0,0,,现在穿的不是那个
Dialogue: 0,0:14:19.23,0:14:22.73,Default,,0,0,0,,肯定会这样的
Dialogue: 0,0:14:22.83,0:14:28.60,Default,,0,0,0,,为什么会这样呢
Dialogue: 0,0:14:28.70,0:14:37.01,Default,,0,0,0,,为什么想做av呢
Dialogue: 0,0:14:37.11,0:14:39.81,Default,,0,0,0,,刚开始
Dialogue: 0,0:14:39.91,0:14:48.42,Default,,0,0,0,,因为想去海外 是为了挣钱
Dialogue: 0,0:14:48.52,0:14:52.02,Default,,0,0,0,,那挣钱了就不做了吗
Dialogue: 0,0:14:53.23,0:15:02.70,Default,,0,0,0,,嗯 这样啊
Dialogue: 0,0:15:02.80,0:15:08.81,Default,,0,0,0,,那面试晌时唉
Dialogue: 0,0:15:08.91,0:15:13.01,Default,,0,0,0,,也没有人示范
Dialogue: 0,0:15:13.11,0:15:17.62,Default,,0,0,0,,那个是怎么回事
Dialogue: 0,0:15:17.72,0:15:19.92,Default,,0,0,0,,那个是之前
Dialogue: 0,0:15:20.02,0:15:24.32,Default,,0,0,0,,你面试了吧 面试了
Dialogue: 0,0:15:24.42,0:15:27.03,Default,,0,0,0,,几年前了 3年前了吧
Dialogue: 0,0:15:27.13,0:15:32.63,Default,,0,0,0,,那个时候想着做一下吧
Dialogue: 0,0:15:32.73,0:15:41.41,Default,,0,0,0,,然后就去面试了
Dialogue: 0,0:15:42.61,0:15:49.11,Default,,0,0,0,,想着能不能被选上呢
Dialogue: 0,0:15:49.21,0:15:54.42,Default,,0,0,0,,这样的心情 也很纠结啊 对
Dialogue: 0,0:15:54.52,0:15:57.72,Default,,0,0,0,,但是这次
Dialogue: 0,0:15:57.82,0:16:02.23,Default,,0,0,0,,都过了三年了
Dialogue: 0,0:16:02.33,0:16:05.63,Default,,0,0,0,,为什么呢 感觉
Dialogue: 0,0:16:05.73,0:16:13.20,Default,,0,0,0,,也没有什么特别想做的
Dialogue: 0,0:16:13.31,0:16:17.41,Default,,0,0,0,,没事吧
Dialogue: 0,0:16:17.51,0:16:25.52,Default,,0,0,0,,这样啊 对 就是没事吧那种感觉
Dialogue: 0,0:16:25.92,0:16:31.42,Default,,0,0,0,,这样啊 现在多大\N21
Dialogue: 0,0:16:31.52,0:16:39.43,Default,,0,0,0,,想过什么样的人生呢
Dialogue: 0,0:16:39.53,0:16:45.20,Default,,0,0,0,,真的很好奇 高中的时候什么样
Dialogue: 0,0:16:45.30,0:16:49.01,Default,,0,0,0,,小时候什么样
Dialogue: 0,0:16:49.11,0:16:57.12,Default,,0,0,0,,怎么说呢 什么样的人生呢 很自由
Dialogue: 0,0:16:57.22,0:16:59.82,Default,,0,0,0,,自由 嗯
Dialogue: 0,0:16:59.92,0:17:06.82,Default,,0,0,0,,做想做的事情 上学 找工作
Dialogue: 0,0:17:06.93,0:17:11.93,Default,,0,0,0,,上了专门的学校
Dialogue: 0,0:17:12.03,0:17:21.81,Default,,0,0,0,,高中是女子高中
Dialogue: 0,0:17:21.91,0:17:31.02,Default,,0,0,0,,没有特别做什么
Dialogue: 0,0:17:31.12,0:17:34.52,Default,,0,0,0,,尽是玩了
Dialogue: 0,0:17:34.62,0:17:38.32,Default,,0,0,0,,是啊 尽是玩了
Dialogue: 0,0:17:38.42,0:17:43.43,Default,,0,0,0,,不良少女？ 有点 染黄头发
Dialogue: 0,0:17:43.53,0:17:53.50,Default,,0,0,0,,初中的时候染过头发 这样啊
Dialogue: 0,0:17:53.61,0:18:01.41,Default,,0,0,0,,应该很受欢迎吧 嗯...
Dialogue: 0,0:18:01.51,0:18:09.62,Default,,0,0,0,,从初中开始谈恋爱？ 嗯 总有
Dialogue: 0,0:18:09.72,0:18:18.23,Default,,0,0,0,,很少有空档期 是啊 基本上没有\N有过多少个男朋友
Dialogue: 0,0:18:18.33,0:18:20.63,Default,,0,0,0,,几个？几个呢
Dialogue: 0,0:18:20.73,0:18:28.51,Default,,0,0,0,,大体的说一下就行了
Dialogue: 0,0:18:28.61,0:18:36.31,Default,,0,0,0,,没有50个吧 真的假的
Dialogue: 0,0:18:40.12,0:18:47.13,Default,,0,0,0,,就是那样吧 嗯
Dialogue: 0,0:18:47.23,0:18:52.73,Default,,0,0,0,,顺便问一下 嗯
Dialogue: 0,0:18:54.13,0:19:02.91,Default,,0,0,0,,那基本上上学的时候来东京玩是吧
Dialogue: 0,0:19:03.01,0:19:04.31,Default,,0,0,0,,是的
Dialogue: 0,0:19:04.41,0:19:07.21,Default,,0,0,0,,去过涩谷呢
Dialogue: 0,0:19:07.31,0:19:15.12,Default,,0,0,0,,在涩谷干什么了 买东酉啦
Dialogue: 0,0:19:17.72,0:19:26.43,Default,,0,0,0,,还要什么呢\N和大家去流行的地方
Dialogue: 0,0:19:27.73,0:19:36.61,Default,,0,0,0,,去过那个店 还有什么呢
Dialogue: 0,0:19:38.01,0:19:44.12,Default,,0,0,0,,晚上玩 俱乐部什么的吗 去过
Dialogue: 0,0:19:44.22,0:19:50.72,Default,,0,0,0,,喜欢这样的吗 嗯喜欢 这样啊
Dialogue: 0,0:19:50.82,0:19:56.33,Default,,0,0,0,,现在去俱乐部吗 偶尔去
Dialogue: 0,0:19:56.43,0:20:00.03,Default,,0,0,0,,俱乐部的魅力是什么呢 什么呢
Dialogue: 0,0:20:00.13,0:20:01.40,Default,,0,0,0,,什么都忘记了
Dialogue: 0,0:20:01.50,0:20:10.61,Default,,0,0,0,,喝酒 然后很开心 就是这样\N啊这样啊
Dialogue: 0,0:20:10.71,0:20:17.11,Default,,0,0,0,,那里会玩的很high是吧 对
Dialogue: 0,0:20:17.22,0:20:26.12,Default,,0,0,0,,和朋友一起去玩挺好的 这样啊
Dialogue: 0,0:20:26.23,0:20:27.93,Default,,0,0,0,,会看AV吗 会看啊
Dialogue: 0,0:20:28.03,0:20:34.23,Default,,0,0,0,,这样啊 看什么样的呢
Dialogue: 0,0:20:34.33,0:20:39.00,Default,,0,0,0,,会看很多类型的 这样啊
Dialogue: 0,0:20:40.21,0:20:46.11,Default,,0,0,0,,怎么说呢
Dialogue: 0,0:20:46.21,0:20:51.52,Default,,0,0,0,,普通的啊 其他的啊
Dialogue: 0,0:20:51.62,0:20:56.92,Default,,0,0,0,,你喜欢那样的啊 喜欢
Dialogue: 0,0:20:57.02,0:21:03.53,Default,,0,0,0,,感觉很刺激
Dialogue: 0,0:21:03.63,0:21:09.90,Default,,0,0,0,,这样啊
Dialogue: 0,0:21:26.32,0:21:29.32,Default,,0,0,0,,去海外旅行过吗
Dialogue: 0,0:21:29.42,0:21:39.43,Default,,0,0,0,,去过很多地方吗 这个月去了韩国\N下个月去夏威夷 去了很多地方
Dialogue: 0,0:21:41.23,0:21:46.70,Default,,0,0,0,,已经到了这个年龄了 想去拉斯维加\N真的吗 嗯
Dialogue: 0,0:21:48.61,0:21:53.41,Default,,0,0,0,,那去过赌场之类的吗
Dialogue: 0,0:21:53.51,0:22:00.72,Default,,0,0,0,,不是太喜欢那种 这样啊
Dialogue: 0,0:22:00.82,0:22:03.82,Default,,0,0,0,,赢了吗
Dialogue: 0,0:22:03.92,0:22:07.02,Default,,0,0,0,,赢了点
Dialogue: 0,0:22:07.13,0:22:12.23,Default,,0,0,0,,多少 3万左右 这样啊
Dialogue: 0,0:22:12.33,0:22:19.40,Default,,0,0,0,,但是这样也挺好的
Dialogue: 0,0:22:19.50,0:22:26.91,Default,,0,0,0,,你觉得什么比较好 那种紧张的感
Dialogue: 0,0:22:28.31,0:22:36.52,Default,,0,0,0,,那你可能比较适合博彩 这个嘛
Dialogue: 0,0:22:36.62,0:22:41.63,Default,,0,0,0,,那个弹钢珠那种呢
Dialogue: 0,0:22:41.73,0:22:43.63,Default,,0,0,0,,玩吗 玩
Dialogue: 0,0:22:43.73,0:22:53.60,Default,,0,0,0,,不是痴迷的那种 是打发时间玩\N这样啊
Dialogue: 0,0:22:53.71,0:23:00.34,Default,,0,0,0,,不是那种一直玩一整天的
Dialogue: 0,0:23:00.41,0:23:08.22,Default,,0,0,0,,有时间的话会稍微玩
Dialogue: 0,0:23:16.83,0:23:26.50,Default,,0,0,0,,那走吧 好
Dialogue: 0,0:23:26.61,0:23:31.81,Default,,0,0,0,,从这边下吧
Dialogue: 0,0:23:34.11,0:23:43.42,Default,,0,0,0,,把这个脱了吧 好
Dialogue: 0,0:23:56.20,0:24:05.11,Default,,0,0,0,,要带这个衣服吗
Dialogue: 0,0:24:32.30,0:24:41.31,Default,,0,0,0,,说句有千劲的话 干劲？
Dialogue: 0,0:24:46.42,0:24:53.12,Default,,0,0,0,,就是平常那种感觉来
Dialogue: 0,0:24:56.63,0:25:04.00,Default,,0,0,0,,我不知道 加油吧
Dialogue: 0,0:25:44.61,0:25:54.12,Default,,0,0,0,,就这样进去就行 好\N在2楼
Dialogue: 0,0:26:13.17,0:26:20.61,Default,,0,0,0,,左边
Dialogue: 0,0:26:47.71,0:26:53.21,Default,,0,0,0,,坐下吧 好
Dialogue: 0,0:27:03.92,0:27:06.22,Default,,0,0,0,,做点性感的
Dialogue: 0,0:27:26.91,0:27:34.72,Default,,0,0,0,,把外套脱了吧 好
Dialogue: 0,0:27:37.72,0:27:44.73,Default,,0,0,0,,自己身体里 自信的地方
Dialogue: 0,0:27:44.83,0:27:49.00,Default,,0,0,0,,自信的地方？
Dialogue: 0,0:27:52.30,0:28:01.01,Default,,0,0,0,,什么啊 脸也行哦 我不知道
Dialogue: 0,0:28:01.81,0:28:02.51,Default,,0,0,0,,哪里
Dialogue: 0,0:28:03.21,0:28:09.12,Default,,0,0,0,,这个地方我很有信心
Dialogue: 0,0:28:15.73,0:28:24.50,Default,,0,0,0,,没有吗 脚什么的
Dialogue: 0,0:28:24.60,0:28:30.21,Default,,0,0,0,,好难为情啊
Dialogue: 0,0:28:39.92,0:28:46.12,Default,,0,0,0,,不是那么难为情的事
Dialogue: 0,0:28:47.13,0:28:52.63,Default,,0,0,0,,现在呢
Dialogue: 0,0:29:12.52,0:29:20.52,Default,,0,0,0,,你好 你好
Dialogue: 0,0:29:20.63,0:29:25.73,Default,,0,0,0,,我也震惊了
Dialogue: 0,0:29:25.83,0:29:33.40,Default,,0,0,0,,这已经是夏天的打扮了
Dialogue: 0,0:29:33.51,0:29:40.71,Default,,0,0,0,,你叫什么 小遥
Dialogue: 0,0:29:42.61,0:29:48.52,Default,,0,0,0,,可以站起来一下吗 好\N后面呢
Dialogue: 0,0:29:50.62,0:29:56.33,Default,,0,0,0,,前面
Dialogue: 0,0:29:57.03,0:30:06.60,Default,,0,0,0,,H吗 平常不做这样的吗
Dialogue: 0,0:30:07.41,0:30:12.71,Default,,0,0,0,,不怎么做
Dialogue: 0,0:30:12.81,0:30:20.62,Default,,0,0,0,,就是这样的感觉
Dialogue: 0,0:30:20.72,0:30:24.02,Default,,0,0,0,,不做模特可惜了
Dialogue: 0,0:30:24.12,0:30:27.12,Default,,0,0,0,,对自己身体自信的地方？
Dialogue: 0,0:30:27.23,0:30:36.30,Default,,0,0,0,,问过了？ 嗯 但是没回答
Dialogue: 0,0:30:41.91,0:30:48.01,Default,,0,0,0,,屁股 那就屁股吧
Dialogue: 0,0:30:48.11,0:30:54.12,Default,,0,0,0,,自己觉得怎么样 屁股？
Dialogue: 0,0:30:54.22,0:30:59.92,Default,,0,0,0,,你怎么评价 是大还是小 不小
Dialogue: 0,0:31:04.13,0:31:11.40,Default,,0,0,0,,就是那样 撅起来屁股
Dialogue: 0,0:31:14.31,0:31:20.31,Default,,0,0,0,,腰好细
Dialogue: 0,0:31:41.13,0:31:50.31,Default,,0,0,0,,好美
Dialogue: 0,0:31:59.22,0:32:07.82,Default,,0,0,0,,好美
Dialogue: 0,0:32:09.13,0:32:18.70,Default,,0,0,0,,开始了哦 好
Dialogue: 0,0:32:43.03,0:32:47.13,Default,,0,0,0,,脱了吧 嗯
Dialogue: 0,0:32:59.21,0:33:09.22,Default,,0,0,0,,刚才感受 好害羞
Dialogue: 0,0:33:26.80,0:33:30.37,Default,,0,0,0,,好美
Dialogue: 0,0:33:41.02,0:33:45.82,Default,,0,0,0,,真美啊
Dialogue: 0,0:33:51.23,0:33:57.50,Default,,0,0,0,,出汗了啊
Dialogue: 0,0:34:15.42,0:34:24.73,Default,,0,0,0,,好热 紧张？ 紧张
Dialogue: 0,0:35:57.52,0:36:01.32,Default,,0,0,0,,好软
Dialogue: 0,0:36:27.92,0:36:37.33,Default,,0,0,0,,好吃
Dialogue: 0,0:37:20.30,0:37:29.81,Default,,0,0,0,,可以看一下
Dialogue: 0,0:37:54.81,0:38:03.01,Default,,0,0,0,,感受到了吧 嗯
Dialogue: 0,0:38:27.61,0:38:35.61,Default,,0,0,0,,坐下吧
Dialogue: 0,0:38:48.63,0:38:54.03,Default,,0,0,0,,不要 讨厌 为什么
Dialogue: 0,0:38:54.13,0:39:01.60,Default,,0,0,0,,好害羞
Dialogue: 0,0:39:10.41,0:39:14.92,Default,,0,0,0,,好漂亮
Dialogue: 0,0:39:19.92,0:39:28.83,Default,,0,0,0,,难道
Dialogue: 0,0:39:30.70,0:39:36.71,Default,,0,0,0,,没有毛吗 为什么没有呢\N觉得不需要
Dialogue: 0,0:39:46.02,0:39:49.32,Default,,0,0,0,,好漂亮
Dialogue: 0,0:41:02.63,0:41:10.30,Default,,0,0,0,,屁股好漂亮
Dialogue: 0,0:41:25.92,0:41:28.52,Default,,0,0,0,,能看到哦
Dialogue: 0,0:41:49.61,0:41:50.51,Default,,0,0,0,,好薄
Dialogue: 0,0:42:02.12,0:42:09.83,Default,,0,0,0,,让我看看屁股
Dialogue: 0,0:42:59.41,0:43:04.71,Default,,0,0,0,,有过这样的经历吗 没有
Dialogue: 0,0:43:04.82,0:43:06.72,Default,,0,0,0,,好香
Dialogue: 0,0:43:09.42,0:43:18.03,Default,,0,0,0,,看这边
Dialogue: 0,0:43:19.53,0:43:27.90,Default,,0,0,0,,有味道了你看
Dialogue: 0,0:44:29.30,0:44:36.91,Default,,0,0,0,,好漂亮
Dialogue: 0,0:45:08.81,0:45:12.41,Default,,0,0,0,,现在什么感觉 好害羞
Dialogue: 0,0:45:13.41,0:45:17.81,Default,,0,0,0,,看起来很高兴啊 高兴吗
Dialogue: 0,0:45:24.12,0:45:32.93,Default,,0,0,0,,为什么笑成这样
Dialogue: 0,0:45:54.92,0:46:01.92,Default,,0,0,0,,讨厌
Dialogue: 0,0:46:14.10,0:46:21.51,Default,,0,0,0,,好漂亮
Dialogue: 0,0:49:35.31,0:49:41.01,Default,,0,0,0,,怎么了
Dialogue: 0,0:49:43.71,0:49:49.62,Default,,0,0,0,,好厉害啊
Dialogue: 0,0:49:55.83,0:50:02.83,Default,,0,0,0,,总这么做吗
Dialogue: 0,0:50:26.42,0:50:35.43,Default,,0,0,0,,舒服吗
Dialogue: 0,0:50:35.53,0:50:37.30,Default,,0,0,0,,总这样吗
Dialogue: 0,0:50:38.10,0:50:40.10,Default,,0,0,0,,像以往一样
Dialogue: 0,0:51:24.21,0:51:33.52,Default,,0,0,0,,看这边
Dialogue: 0,0:52:28.31,0:52:37.72,Default,,0,0,0,,脱下内裤 吃的速度就快了啊
Dialogue: 0,0:53:31.51,0:53:41.22,Default,,0,0,0,,边看边舔
Dialogue: 0,0:53:56.13,0:54:02.81,Default,,0,0,0,,喜欢吗
Dialogue: 0,0:54:02.91,0:54:09.41,Default,,0,0,0,,喜欢舔还是不喜欢
Dialogue: 0,0:54:59.43,0:55:09.10,Default,,0,0,0,,不得了了
Dialogue: 0,0:55:23.92,0:55:33.63,Default,,0,0,0,,不行了 好厉害 可以一直吃
Dialogue: 0,0:56:26.32,0:56:33.52,Default,,0,0,0,,像这样做怎么样
Dialogue: 0,0:56:36.73,0:56:45.30,Default,,0,0,0,,看不见啊
Dialogue: 0,0:57:32.92,0:57:42.22,Default,,0,0,0,,感觉怎么样 什么味道
Dialogue: 0,0:57:44.73,0:57:53.30,Default,,0,0,0,,什么味道
Dialogue: 0,0:57:59.01,0:58:04.41,Default,,0,0,0,,有味道？ 嗯
Dialogue: 0,0:58:27.60,0:58:32.91,Default,,0,0,0,,阴茎变大了吗 变大了
Dialogue: 0,0:58:33.01,0:58:37.01,Default,,0,0,0,,想插进去吗
Dialogue: 0,0:58:58.70,0:59:00.10,Default,,0,0,0,,插进来吧
Dialogue: 0,0:59:23.93,0:59:26.73,Default,,0,0,0,,好湿
Dialogue: 0,0:59:31.00,0:59:35.10,Default,,0,0,0,,插进来了哦
Dialogue: 0,1:00:36.23,1:00:44.21,Default,,0,0,0,,舒服吗 舒服
Dialogue: 0,1:04:29.73,1:04:37.31,Default,,0,0,0,,真美
Dialogue: 0,1:06:52.61,1:07:01.42,Default,,0,0,0,,舒服吗
Dialogue: 0,1:07:07.42,1:07:12.63,Default,,0,0,0,,喜欢吗
Dialogue: 0,1:10:26.42,1:10:34.63,Default,,0,0,0,,你觉得AV里谁比较厉害
Dialogue: 0,1:11:56.01,1:12:04.82,Default,,0,0,0,,爽吧
Dialogue: 0,1:12:36.52,1:12:46.33,Default,,0,0,0,,好舒服
Dialogue: 0,1:12:50.03,1:12:58.81,Default,,0,0,0,,要射了
Dialogue: 0,1:14:53.02,1:14:59.13,Default,,0,0,0,,要射了
Dialogue: 0,1:16:06.13,1:16:15.80,Default,,0,0,0,,AV的sex感觉怎么样\N不一样的感觉
Dialogue: 0,1:16:15.90,1:16:25.41,Default,,0,0,0,,什么比较好呢 舒服吗
Dialogue: 0,1:16:32.22,1:16:34.52,Default,,0,0,0,,很舒服
Dialogue: 0,1:16:42.63,1:16:50.30,Default,,0,0,0,,你也很喜欢吗 嗯
Dialogue: 0,1:16:53.61,1:16:58.71,Default,,0,0,0,,这样啊
Dialogue: 0,1:17:00.42,1:17:09.62,Default,,0,0,0,,吃什么的习惯了吗 嗯习惯了
Dialogue: 0,1:17:10.73,1:17:20.40,Default,,0,0,0,,为什么？
Dialogue: 0,1:17:20.50,1:17:30.21,Default,,0,0,0,,从就18开始了 这样啊\N什么感觉呢
Dialogue: 0,1:17:37.62,1:17:42.62,Default,,0,0,0,,真的假的
Dialogue: 0,1:17:42.72,1:17:52.10,Default,,0,0,0,,真的吗
Dialogue: 0,1:17:55.10,1:18:01.81,Default,,0,0,0,,好像被强迫一样\N要做吗 做吧
Dialogue: 0,1:18:07.52,1:18:11.02,Default,,0,0,0,,稍微吧
Dialogue: 0,1:18:15.52,1:18:20.83,Default,,0,0,0,,真的假的 那样好讨厌
Dialogue: 0,1:18:20.93,1:18:25.80,Default,,0,0,0,,真的吗？为什么在这
Dialogue: 0,1:18:25.90,1:18:35.71,Default,,0,0,0,,稍微做一点 真的吗
Dialogue: 0,1:18:35.81,1:18:42.32,Default,,0,0,0,,可以吗 可以
Dialogue: 0,1:19:11.41,1:19:17.72,Default,,0,0,0,,很认真的在看哦
Dialogue: 0,1:20:40.50,1:20:43.00,Default,,0,0,0,,好害羞
Dialogue: 0,1:20:46.71,1:20:56.12,Default,,0,0,0,,感觉怎么样 讨厌\N在人面前这么做过吗
Dialogue: 0,1:21:00.92,1:21:04.12,Default,,0,0,0,,没有没有
Dialogue: 0,1:21:04.83,1:21:06.83,Default,,0,0,0,,没在这么多人面前做过
Dialogue: 0,1:21:06.93,1:21:15.60,Default,,0,0,0,,这么多人 确实 一对一的是吧
Dialogue: 0,1:21:18.11,1:21:25.11,Default,,0,0,0,,很色情啊
Dialogue: 0,1:21:48.10,1:21:50.91,Default,,0,0,0,,怎么样
Dialogue: 0,1:21:51.01,1:21:58.51,Default,,0,0,0,,感觉怎么样
Dialogue: 0,1:21:58.61,1:22:08.62,Default,,0,0,0,,比想象中要普通 什么意思
Dialogue: 0,1:22:08.72,1:22:10.72,Default,,0,0,0,,紧张啊
Dialogue: 0,1:22:11.83,1:22:19.90,Default,,0,0,0,,很紧张啊 是的
Dialogue: 0,1:22:20.00,1:22:22.40,Default,,0,0,0,,在摄像机面前做
Dialogue: 0,1:22:23.10,1:22:25.31,Default,,0,0,0,,感觉很违和
Dialogue: 0,1:22:26.01,1:22:30.81,Default,,0,0,0,,感觉违和啊 嗯
Dialogue: 0,1:22:33.62,1:22:38.82,Default,,0,0,0,,和平常接触的不太一样
Dialogue: 0,1:22:39.82,1:22:49.13,Default,,0,0,0,,有一种被看的感觉 是的
Dialogue: 0,1:22:50.03,1:22:52.70,Default,,0,0,0,,后悔做AV了吗
Dialogue: 0,1:22:53.40,1:23:00.91,Default,,0,0,0,,嗯 做到现在了 有过纠结的时候\N嗯
Dialogue: 0,1:23:01.01,1:23:07.21,Default,,0,0,0,,尝试一下 就是这种感觉
Dialogue: 0,1:23:08.02,1:23:13.12,Default,,0,0,0,,到现在了
Dialogue: 0,1:23:17.63,1:23:18.13,Default,,0,0,0,,还是挺好的
Dialogue: 0,1:23:22.33,1:23:31.71,Default,,0,0,0,,摄影第二天东京目黑区某摄影棚\N就是那种感觉
Dialogue: 0,1:23:31.81,1:23:40.41,Default,,0,0,0,,对对对 就是这样
Dialogue: 0,1:23:54.33,1:24:03.20,Default,,0,0,0,,刚才拍的很好啊 真的吗
Dialogue: 0,1:24:03.30,1:24:07.01,Default,,0,0,0,,感觉把额头露出来就很有自信\N是吗
Dialogue: 0,1:24:08.01,1:24:13.01,Default,,0,0,0,,好美
Dialogue: 0,1:24:13.11,1:24:20.32,Default,,0,0,0,,昨天晚上睡得好吗 嗯 前天没睡
Dialogue: 0,1:24:20.42,1:24:24.02,Default,,0,0,0,,昨天睡得很好
Dialogue: 0,1:24:24.13,1:24:26.93,Default,,0,0,0,,感觉今天身体状况不是特别好
Dialogue: 0,1:24:27.03,1:24:31.03,Default,,0,0,0,,还行吧
Dialogue: 0,1:24:31.13,1:24:38.91,Default,,0,0,0,,真的吗 挺好的
Dialogue: 0,1:24:39.01,1:24:44.31,Default,,0,0,0,,今天也要尝试各种各样的
Dialogue: 0,1:24:51.92,1:24:55.52,Default,,0,0,0,,今天是全新的历练 嗯
Dialogue: 0,1:24:55.62,1:24:58.63,Default,,0,0,0,,私服挺好的啊
Dialogue: 0,1:24:58.63,1:25:07.10,Default,,0,0,0,,我觉得挺好的 最近那个衣服
Dialogue: 0,1:25:09.00,1:25:16.61,Default,,0,0,0,,这个也是纠结了很久买的
Dialogue: 0,1:25:16.71,1:25:26.12,Default,,0,0,0,,有很多衣服吧 嗯 确实很多
Dialogue: 0,1:25:26.22,1:25:32.43,Default,,0,0,0,,不是特别贵吗 没那么贵
Dialogue: 0,1:25:32.53,1:25:37.83,Default,,0,0,0,,我姐姐也喜欢这种风格 有时候会红
Dialogue: 0,1:25:37.93,1:25:44.00,Default,,0,0,0,,这样啊 嗯 顺便问一下姐姐多
Dialogue: 0,1:25:44.11,1:25:48.41,Default,,0,0,0,,我21 姐姐呢
Dialogue: 0,1:25:48.51,1:25:52.31,Default,,0,0,0,,比我大7岁 这样啊
Dialogue: 0,1:25:52.41,1:25:53.81,Default,,0,0,0,,长得像吗
Dialogue: 0,1:25:58.22,1:26:02.52,Default,,0,0,0,,虽说很像 但是姐姐超级可爱
Dialogue: 0,1:26:02.62,1:26:06.43,Default,,0,0,0,,我上学的时候 高中吧
Dialogue: 0,1:26:06.53,1:26:12.80,Default,,0,0,0,,朋友就会说姐姐很可爱
Dialogue: 0,1:26:12.90,1:26:14.90,Default,,0,0,0,,真的吗
Dialogue: 0,1:26:15.00,1:26:21.71,Default,,0,0,0,,我就会想我为什么没那么可爱呢
Dialogue: 0,1:26:21.81,1:26:30.12,Default,,0,0,0,,姐姐很可爱 好感兴趣
Dialogue: 0,1:26:32.92,1:26:34.62,Default,,0,0,0,,结婚了吗 嗯
Dialogue: 0,1:26:34.72,1:26:43.93,Default,,0,0,0,,都结婚了 就差你了啊 嗯
Dialogue: 0,1:26:44.03,1:26:46.00,Default,,0,0,0,,想什么时候结婚
Dialogue: 0,1:26:46.10,1:26:49.10,Default,,0,0,0,,没想过
Dialogue: 0,1:26:49.20,1:26:52.41,Default,,0,0,0,,没有 没有啊
Dialogue: 0,1:26:52.51,1:27:01.52,Default,,0,0,0,,3 0岁左右赠 30啊
Dialogue: 0,1:27:01.62,1:27:05.12,Default,,0,0,0,,一周来几次涩谷呢
Dialogue: 0,1:27:08.72,1:27:16.23,Default,,0,0,0,,一周2、3次吧 这么多啊\N嗯 经常来
Dialogue: 0,1:27:25.64,1:27:26.07,Default,,0,0,0,,222
Dialogue: 0,1:27:27.94,1:27:28.38,Default,,0,0,0,,222
Dialogue: 0,1:27:29.51,1:27:35.12,Default,,0,0,0,,重回回忆之地 涩谷
Dialogue: 0,1:27:54.00,1:27:59.91,Default,,0,0,0,,对于她来说家乡一样存在的涩谷
Dialogue: 0,1:28:08.32,1:28:17.82,Default,,0,0,0,,青春时期和现在都经常来的涩谷
Dialogue: 0,1:28:17.93,1:28:25.30,Default,,0,0,0,,下次摄影就在涩谷吧
Dialogue: 0,1:28:27.90,1:28:37.91,Default,,0,0,0,,就在这 嗯
Dialogue: 0,1:28:44.92,1:28:51.02,Default,,0,0,0,,走好快
Dialogue: 0,1:28:51.13,1:28:55.73,Default,,0,0,0,,在405
Dialogue: 0,1:29:13.31,1:29:20.82,Default,,0,0,0,,你进房间了 我在外面等着
Dialogue: 0,1:29:22.92,1:29:31.13,Default,,0,0,0,,留你们两个人 嗯
Dialogue: 0,1:29:31.23,1:29:41.21,Default,,0,0,0,,这吗 嗯
Dialogue: 0,1:29:49.42,1:29:57.92,Default,,0,0,0,,你好 你好
